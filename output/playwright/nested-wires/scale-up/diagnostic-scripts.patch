+/** Read-only M7 STOP proof. Node owns assertion/I/O errors; correct and rerun. */
+import assert from 'node:assert/strict';
+import { execFileSync } from 'node:child_process';
+import { readFileSync } from 'node:fs';
+import { runInNewContext } from 'node:vm';
+import { createNestedRoadScene, fanInHubSceneSpec } from '../../../../capability/layout/contract/index.ts';
+
+const directory = new URL('./', import.meta.url);
+const source = readFileSync(new URL('probe-demand-clearance.mjs', directory), 'utf8');
+const predicate = source.match(/function compactSection\(directNodeCount\) \{\n  return directNodeCount <= 2;\n\}/)?.[0];
+assert(predicate, 'probe predicate must depend on direct-node count alone');
+const compact = runInNewContext(predicate + '\ncompactSection');
+const nested = createNestedRoadScene({ spec: fanInHubSceneSpec });
+const rows = nested.sections.map((section) => {
+  const directNodeCount = nested.nodes.filter((node) => node.sectionId === section.id).length;
+  return { section: section.id, directNodeCount, compact: compact(directNodeCount) };
+});
+for (const row of rows) console.log('ENUMERATION ' + JSON.stringify(row));
+assert.deepEqual(rows.map((row) => row.directNodeCount), [6, 6, 6, 6]);
+assert.equal(rows.filter((row) => row.compact).length, 0);
+console.log('PASS rejected sizing-policy trigger matches zero nested sections (no runtime compact path installed)');
+function original(path) {
+  return execFileSync('git', ['show', `f77907c:${path}`], { encoding: 'utf8', maxBuffer: 16 * 1024 * 1024 });
+}
+assert.equal(JSON.stringify(nested, null, 2) + '\n', original('output/playwright/nested-wires/scene.json'));
+console.log('PASS fresh full nested serialization byte-identical to f77907c');
+const spec = JSON.parse(readFileSync(new URL('../templates-scene/scene-spec.json', directory)));
+assert.equal(JSON.stringify(createNestedRoadScene({ spec }), null, 2) + '\n', original('output/playwright/nested-wires/templates-scene/scene.json'));
+console.log('PASS fresh full templates serialization byte-identical to f77907c');
+assert.equal(execFileSync('git', ['diff', '--name-only', 'f77907c', '--', 'capability', 'apps'], { encoding: 'utf8' }), '');
+console.log('PASS production source unchanged from f77907c');
+const tracked = execFileSync('git', ['diff', '--name-only', '--diff-filter=A', 'f77907c', '--', '*.test.ts'], { encoding: 'utf8' });
+const untracked = execFileSync('git', ['ls-files', '--others', '--exclude-standard', '--', '*.test.ts'], { encoding: 'utf8' });
+assert.equal(tracked + untracked, '');
+console.log('PASS zero new tracked or untracked *.test.ts files');
