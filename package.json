{
  "name": "@novakai/canvas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "architecture": "depcruise capability apps --config .dependency-cruiser.cjs --output-type err",
    "test": "vitest run capability",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm architecture && pnpm test",
    "format:check": "prettier --check \"capability/**/*.{ts,tsx}\" eslint.config.js .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/node": "25.2.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.10.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
