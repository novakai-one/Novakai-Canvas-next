# grid-research-methods revision=1
canvas 1
collection @grid-research-methods "Research methods evidence matrix" theme="paper@1.0.0#sha256:84274780305931de95fcb434258bb9c7f27437adc265839eb7b61bf080e63ac9" description="Illustrative method selection aid; evidence strength depends on execution." layout=grid {
  node @question concept "Start with the claim" role=primary size=medium sources=[] {
  text @detail "Choose evidence that can challenge the claim."
}
  node @experiment concept "Experiment" role=success size=medium sources=[] {
  table @matrix columns=["Dimension", "Evidence"] {
  row @question cells=["Question", "Did a change affect an outcome?"]
  row @record cells=["Record", "Assigned groups and outcomes"]
  row @limit cells=["Limit", "Setting may constrain transfer"]
}
}
  node @cohort concept "Cohort study" role=supporting size=medium sources=[] {
  table @matrix columns=["Dimension", "Evidence"] {
  row @question cells=["Question", "What changes over time?"]
  row @record cells=["Record", "Repeated observations"]
  row @limit cells=["Limit", "Confounding and attrition"]
}
}
  node @case concept "Case study" role=neutral size=medium sources=[] {
  table @matrix columns=["Dimension", "Evidence"] {
  row @question cells=["Question", "How did this case unfold?"]
  row @record cells=["Record", "Documents and accounts"]
  row @limit cells=["Limit", "Case selection shapes scope"]
}
}
  node @synthesis concept "Evidence synthesis" role=neutral size=medium sources=[] {
  table @matrix columns=["Dimension", "Evidence"] {
  row @question cells=["Question", "What do studies agree on?"]
  row @record cells=["Record", "Included studies and quality"]
  row @limit cells=["Limit", "Missing or uneven studies"]
}
}
  node @causal note "Before a causal claim" role=warning size=medium sources=[] {
  list @checks ["Check the comparison", "Check assignment and missing data"]
}
  node @triangulate note "Combine complementary evidence" role=neutral size=medium sources=[] {
  text @detail "Use case context to interpret patterns; test explanations with new comparisons."
  list @checks ["Seek contradictory cases", "Record unresolved disagreements"]
}
  section @methods "RESEARCH METHODS / Compare questions, records and limits" mode=grid columns=2 layout=grid gap=compact {
  show @question
  show @triangulate
  group @primary "COLLECT PRIMARY EVIDENCE" columns=2 layout=grid gap=compact {
  show @experiment
  show @cohort
  show @case
}
  group @secondary "REUSE AND CHALLENGE" columns=1 layout=grid gap=compact {
  show @synthesis
  show @causal
}
}
}