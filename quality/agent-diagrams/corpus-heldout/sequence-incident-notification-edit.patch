patch 1 @sequence-incident-notification {
  replace section @notification "NOTIFICATION / Deduplicate, optionally page, acknowledge" mode=sequence direction=down gap=compact {
  show @monitor @incident @directory @pager @responder
  event @report @monitor -> @incident "Report alert fingerprint" kind=call activate=true
  event @dedupe @incident -> @incident "Check deduplication window" kind=call
  fragment @page opt "New actionable incident" {
   event @lookup @incident -> @directory "Resolve current on-call" kind=call activate=true
   event @contact @directory -> @incident "Return contact route" kind=return activate=false
   event @send @incident -> @pager "Queue incident page" kind=call activate=true
   event @queued @pager -> @incident "Return delivery receipt" kind=return activate=false
   event @deliver @pager -> @responder "Deliver incident page" kind=async
  }
  event @receipt @incident -> @monitor "Return incident identity" kind=return activate=false
  fragment @acknowledge opt "Responder accepts ownership" {
   event @ack @responder -> @incident "Acknowledge incident" kind=call activate=true
   event @record @incident -> @incident "Record owner and timestamp" kind=call
   event @notify-owner @incident -> @pager "Cancel outstanding escalation" kind=async
   event @confirmed @incident -> @responder "Confirm ownership" kind=return activate=false
  }
 }
}
