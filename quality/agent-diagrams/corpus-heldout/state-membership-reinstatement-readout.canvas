# state-membership-reinstatement revision=0
canvas 1
collection @state-membership-reinstatement "Membership reinstatement" theme="paper@1.0.0#sha256:84274780305931de95fcb434258bb9c7f27437adc265839eb7b61bf080e63ac9" description="Illustrative club policy: review restores access; closure is final." layout=grid {
  node @start start "Application" role=neutral size=medium sources=[] {

}
  node @pending state "Pending approval" role=supporting size=medium sources=[] {

}
  node @active state "Active" role=success size=medium sources=[] {
  text @detail "Member privileges are enabled."
}
  node @suspended state "Suspended" role=warning size=medium sources=[] {
  text @detail "Privileges paused; history retained."
}
  node @review state "Reinstatement review" role=primary size=medium sources=[] {
  text @detail "Verify the remedy and reviewer decision."
}
  node @restored state "Reinstated" role=success size=medium sources=[] {
  text @detail "Access restored with a monitored review period."
}
  node @closed end "Closed" role=neutral size=medium sources=[] {

}
  wire @submit @start -> @pending "submit application" kind=transition effect="record applicant" sources=[]
  wire @approve @pending -> @active "approve" kind=transition guard="eligibility confirmed" effect="enable privileges" sources=[]
  wire @decline @pending -> @closed "decline" kind=transition guard="ineligible" effect="retain decision" sources=[]
  wire @suspend @active -> @suspended "suspend" kind=transition guard="policy breach upheld" effect="pause privileges" sources=[]
  wire @appeal @suspended -> @review "request reinstatement" kind=transition guard="remedy submitted" sources=[]
  wire @reject @review -> @suspended "request more evidence" kind=transition guard="remedy incomplete" sources=[]
  wire @restore @review -> @restored "approve reinstatement" kind=transition guard="remedy verified" effect="restore privileges" sources=[]
  wire @complete @restored -> @active "complete review period" kind=transition guard="conditions met" sources=[]
  wire @relapse @restored -> @suspended "suspend again" kind=transition guard="conditions breached" sources=[]
  wire @withdraw @suspended -> @closed "withdraw membership" kind=transition guard="member requests closure" sources=[]
  section @membership "MEMBERSHIP / Reinstatement is a reviewed return" mode=state layout=layered gap=compact {
  show @start
  show @pending
  show @active
  show @suspended
  show @review
  show @restored
  show @closed
  connect @submit
  connect @approve
  connect @decline
  connect @suspend
  connect @appeal
  connect @reject
  connect @restore
  connect @complete
  connect @relapse
  connect @withdraw
}
}