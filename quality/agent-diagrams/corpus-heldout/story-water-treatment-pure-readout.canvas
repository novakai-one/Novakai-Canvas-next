canvas 1
collection @story-water-treatment "How water treatment uses several barriers" theme="paper@1.0.0#sha256:84274780305931de95fcb434258bb9c7f27437adc265839eb7b61bf080e63ac9" description="Simplified conventional treatment story; processes vary with source water." layout=grid {
  asset @water image source="sha256:2d097a777ce681ba9b33dd262db05e5d034366f38248ef01d91c033a8ffdebb5" alt="Water drop: water moving through treatment"
  asset @evidence image source="sha256:818b66016f00a0f635c61481b60962e24eb39e85d3bdeab5322265efe3e766cb" alt="Inspection document: sample and check"
  asset @shield image source="sha256:71b2b9456da8b8f2c6bc2f3fa27abfefdfb9f0608fb2aabf85d3f82f4e536b11" alt="Shield: a protective treatment barrier"
  node @source concept "1. Source and screen" role=primary size=medium sources=[] {
  icon @symbol asset=@water size=medium
  text @detail "Remove large debris at the intake."
}
  node @settle concept "2. Form and settle floc" role=neutral size=medium sources=[] {
  icon @symbol asset=@water size=medium
  text @detail "Gather fine particles into floc that can settle."
}
  node @filter concept "3. Filter" role=supporting size=medium sources=[] {
  icon @symbol asset=@shield size=medium
  text @detail "Pass clarified water through filter media."
}
  node @disinfect concept "4. Disinfect" role=success size=medium sources=[] {
  icon @symbol asset=@shield size=medium
  text @detail "Apply a controlled disinfection step."
}
  node @monitor note "Check at each barrier" role=primary size=medium sources=[] {
  icon @symbol asset=@evidence size=medium
  text @detail "Samples and instruments track treatment performance."
}
  node @residuals note "A second material stream" role=warning size=medium sources=[] {
  text @detail "Settled solids and filter wash water need separate handling."
}
  node @limits note "Water quality sets the process" role=neutral size=medium sources=[] {
  text @detail "No single barrier addresses every contaminant."
}
  node @supply concept "5. Store and distribute" role=success size=medium sources=[] {
  icon @symbol asset=@water size=medium
  text @detail "Protect treated water as it reaches the network."
}
  section @treatment "WATER TREATMENT / Follow water and its checks" mode=story columns=2 layout=grid gap=compact {
  show @supply
  show @limits
  group @water-path "WATER PATH" columns=2 layout=grid gap=compact {
  show @source
  show @settle
  show @filter
  show @disinfect
}
  group @oversight "ALONGSIDE TREATMENT" columns=1 layout=grid gap=compact {
  show @monitor
  show @residuals
}
}
