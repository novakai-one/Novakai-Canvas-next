# tree-incident-causes revision=0
canvas 1
collection @tree-incident-causes "Incident cause hypotheses" theme="paper@1.0.0#sha256:84274780305931de95fcb434258bb9c7f27437adc265839eb7b61bf080e63ac9" description="Illustrative investigation map; branches are hypotheses, not established causes." layout=grid {
  node @incident concept "Checkout interruption" role=primary size=medium sources=[] {
  text @detail "Explain the interruption using evidence."
}
  node @trigger concept "Trigger" role=warning size=medium sources=[] {

}
  node @deploy concept "Configuration release" role=neutral size=medium sources=[] {
  text @detail "Compare the deployed limit with the prior value."
}
  node @capacity concept "Capacity conditions" role=supporting size=medium sources=[] {

}
  node @pool concept "Connection pool exhausted" role=neutral size=medium sources=[] {

}
  node @held concept "Connections held too long" role=neutral size=medium sources=[] {

}
  node @timeout concept "Missing query timeout" role=neutral size=medium sources=[] {
  text @detail "Inspect slow-query traces and cancellation."
}
  node @traffic concept "Traffic concentration" role=neutral size=medium sources=[] {
  text @detail "Compare arrival rate across partitions."
}
  node @detection concept "Detection gap" role=neutral size=medium sources=[] {
  text @detail "Check why user errors preceded the page."
}
  node @recovery concept "Recovery friction" role=neutral size=medium sources=[] {

}
  node @runbook concept "Unclear rollback owner" role=neutral size=medium sources=[] {
  text @detail "Compare handover notes with the incident timeline."
}
  wire @trigger-branch @incident -> @trigger "possible trigger" kind=parent sources=[]
  wire @release @trigger -> @deploy "candidate change" kind=parent sources=[]
  wire @capacity-branch @incident -> @capacity "possible amplifier" kind=parent sources=[]
  wire @pool-path @capacity -> @pool "resource symptom" kind=parent sources=[]
  wire @held-path @pool -> @held "possible mechanism" kind=parent sources=[]
  wire @timeout-path @held -> @timeout "candidate control gap" kind=parent sources=[]
  wire @traffic-path @capacity -> @traffic "alternate pressure" kind=parent sources=[]
  wire @detect-branch @incident -> @detection "time to notice" kind=parent sources=[]
  wire @recover-branch @incident -> @recovery "time to recover" kind=parent sources=[]
  wire @owner-path @recovery -> @runbook "candidate delay" kind=parent sources=[]
  section @causes "INCIDENT CAUSES / Test branches against the timeline" mode=tree layout=tree direction=down gap=compact {
  show @incident
  show @trigger
  show @deploy
  show @capacity
  show @pool
  show @held
  show @timeout
  show @traffic
  show @detection
  show @recovery
  show @runbook
  connect @trigger-branch
  connect @release
  connect @capacity-branch
  connect @pool-path
  connect @held-path
  connect @timeout-path
  connect @traffic-path
  connect @detect-branch
  connect @recover-branch
  connect @owner-path
  root @incident
}
}