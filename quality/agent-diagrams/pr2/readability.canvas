canvas 1 collection @typography "Readable engineering content" {
 node @customer entity "Customer lifecycle records" {
  field @id "customer_id" type="CustomerId" key=primary
  field @external "external_customer_identifier" type="ExternalReference" key=unique
  field @email "email_address" type="Email"
 }
 node @dispatch function "Dispatch a validated request" {
  signature @call "dispatch" parameters=["request: ValidatedRequest", "context: ExecutionContext", "options: DispatchOptions"] returns="Result"
 }
 section @data "Customer data" mode=er { show @customer }
 section @contracts "Application contracts" mode=modules { show @dispatch }
}
