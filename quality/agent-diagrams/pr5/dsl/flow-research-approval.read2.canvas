collection @flow-research-approval "Research approval workflow" theme="paper@1.0.0#sha256:26f6c69a71213b2315ac1000f6dff35d82d819af11e11f6d00fc25696e5be094" layout=grid {
  node @submit start "Protocol submitted" role=primary size=small sources=[] {

}
  node @triage step "Administrative triage" role=neutral size=medium sources=[] {
  text @detail "Confirm ownership, version and required documents."
}
  node @split fork "Parallel review" role=supporting size=small sources=[] {

}
  node @ethics step "Ethics review" role=neutral size=large sources=[] {
  text @detail "Assess consent, risk and participant safeguards."
}
  node @methods step "Methods review" role=neutral size=large sources=[] {
  text @detail "Assess design, sample and analysis plan."
}
  node @merge join "Reviews complete" role=supporting size=small sources=[] {

}
  node @decision decision "Both reviews approve?" role=decision size=medium sources=[] {

}
  node @revise step "Revise protocol" role=warning size=medium sources=[] {
  text @detail "Resolve the consolidated requests before resubmission."
}
  node @approved end "Approval recorded" role=success size=small sources=[] {

}
  wire @begin @submit -> @triage "open case" sources=[]
  wire @ready @triage -> @split "documents complete" sources=[]
  wire @ethics-path @split -> @ethics "review safeguards" sources=[]
  wire @methods-path @split -> @methods "review evidence plan" sources=[]
  wire @ethics-done @ethics -> @merge "ethics recommendation" sources=[]
  wire @methods-done @methods -> @merge "methods recommendation" sources=[]
  wire @decide @merge -> @decision "combine findings" sources=[]
  wire @accept @decision -> @approved "yes" sources=[]
  wire @changes @decision -> @revise "no · changes required" sources=[]
  wire @resubmit @revise -> @triage "resubmit new version" style=dashed sources=[]
  section @approval "RESEARCH APPROVAL / Independent review, one decision" layout=flow gap=compact {
  show @submit
  show @triage
  show @split
  show @ethics
  show @methods
  show @merge
  show @decision
  show @revise
  show @approved
  connect @begin
