# modules-document-publishing revision=0
canvas 1
collection @modules-document-publishing "Document publishing boundary" theme="paper@1.0.0#sha256:26f6c69a71213b2315ac1000f6dff35d82d819af11e11f6d00fc25696e5be094" layout=grid {
  node @editor module "Editorial workspace" role=primary size=large sources=[] {
  port @drafts out "drafts" type="DraftRepository"
  port @publish out "publisher" type="PublicationPort"
}
  node @publication interface "PublicationPort" role=supporting size=medium sources=[] {
  member @submit "submit" type="(ApprovedDraft) => Promise<PublicationReceipt>"
  member @withdraw "withdraw" type="(PublicationId, Reason) => Promise<WithdrawalReceipt>"
}
  node @validate function "validateApproval" role=neutral size=medium sources=[] {
  signature @call "validateApproval" parameters=["draft: Draft", "policy: EditorialPolicy"] returns="Result<ApprovedDraft, ValidationError>"
}
  node @web-adapter module "Web publisher adapter" role=success size=large sources=[] {
  port @input in "approved draft" type="ApprovedDraft"
  port @remote out "CMS client" type="CmsClient"
}
  node @cms interface "External CMS" role=warning size=small sources=[] {
  member @create "createPage" type="(CmsPage) => Promise<CmsPageId>"
}
  wire @checks @editor.@drafts -> @validate "validates approval with" kind=calls sources=[]
  wire @imports @editor.@publish -> @publication "depends on publishing contract" kind=imports sources=[]
  wire @implements @web-adapter.@input -> @publication.@submit "implements submit" kind=implements sources=[]
  wire @calls-cms @web-adapter.@remote -> @cms "imports the external CMS contract" kind=imports sources=[]
  section @publishing-boundary "PUBLISHING / Policy inside, vendor outside" mode=modules layout=layered gap=compact {
  show @editor
  show @validate
  show @publication
  show @web-adapter
  show @cms
  connect @checks
  connect @imports
  connect @implements
  connect @calls-cms
}
}
