# sequence-payment-settlement revision=0
canvas 1
collection @sequence-payment-settlement "Payment settlement conversation" theme="paper@1.0.0#sha256:26f6c69a71213b2315ac1000f6dff35d82d819af11e11f6d00fc25696e5be094" layout=grid {
  node @merchant participant "Merchant" role=primary size=medium sources=[] {

}
  node @payments participant "Payment service" role=supporting size=large sources=[] {

}
  node @ledger participant "Ledger" role=neutral size=medium sources=[] {

}
  node @network participant "Bank network" role=warning size=large sources=[] {

}
  node @webhook participant "Merchant webhook" role=success size=small sources=[] {

}
  section @settlement "SETTLEMENT / Retry submission, confirm asynchronously" mode=sequence layout=sequence direction=down gap=compact {
  show @merchant
  show @payments
  show @ledger
  show @network
  show @webhook
  event @capture @merchant -> @payments "Capture authorized payment" activate=true
  event @pending @payments -> @ledger "Record pending settlement"
  fragment @attempts loop "Until accepted or retry limit" {
  event @submit @payments -> @network "Submit settlement batch" activate=true
  event @ack @network -> @payments "Return batch acceptance" kind=return activate=false
}
  event @accepted @payments -> @merchant "Return accepted receipt" kind=return activate=false
  event @callback @network -> @payments "Settlement completed callback" kind=async activate=true
  event @post @payments -> @ledger "Post final settlement"
  event @notify @payments -> @webhook "Publish settlement outcome" kind=async activate=false
}
}
