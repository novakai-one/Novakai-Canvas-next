# state-batch-job revision=0
canvas 1
collection @state-batch-job "Batch job retry lifecycle" theme="paper@1.0.0#sha256:26f6c69a71213b2315ac1000f6dff35d82d819af11e11f6d00fc25696e5be094" layout=grid {
  node @start start "Queued" role=neutral size=small sources=[] {

}
  node @running state "Running" role=primary size=large sources=[] {
  text @detail "Process the claimed batch under one attempt."
}
  node @backoff state "Waiting to retry" role=warning size=medium sources=[] {
  text @detail "Keep the failure and schedule the next attempt."
}
  node @cancelling state "Cancelling" role=supporting size=medium sources=[] {
  text @detail "Stop new work and release held resources."
}
  node @failed state "Failed" role=warning size=medium sources=[] {
  text @detail "Retry budget is exhausted."
}
  node @succeeded state "Succeeded" role=success size=medium sources=[] {
  text @detail "Outputs and completion receipt are durable."
}
  node @end end "Terminal" role=neutral size=small sources=[] {

}
  wire @claim @start -> @running "claim batch" kind=transition guard="worker available" effect="increment attempt" sources=[]
  wire @retry @running -> @backoff "schedule retry" kind=transition guard="transient failure and attempts remain" effect="record error" sources=[]
  wire @resume @backoff -> @running "retry batch" kind=transition guard="backoff elapsed" effect="increment attempt" sources=[]
  wire @exhaust @running -> @failed "mark failed" kind=transition guard="retry budget exhausted" effect="retain diagnostics" sources=[]
  wire @complete @running -> @succeeded "commit outputs" kind=transition guard="all items processed" effect="write receipt" sources=[]
  wire @cancel-running @running -> @cancelling "request cancel" kind=transition guard="operator requested" sources=[]
  wire @cancel-wait @backoff -> @cancelling "cancel scheduled retry" kind=transition guard="operator requested" sources=[]
  wire @cancelled @cancelling -> @end "confirm cancelled" kind=transition guard="resources released" effect="write cancellation receipt" sources=[]
  wire @finish-failed @failed -> @end "close failed job" kind=transition effect="publish outcome" sources=[]
  wire @finish-success @succeeded -> @end "close successful job" kind=transition effect="publish outcome" sources=[]
  section @job "BATCH JOB / Retry transient faults, cancel cleanly" mode=state layout=layered gap=compact {
  show @start
  show @running
  show @backoff
  show @cancelling
  show @failed
  show @succeeded
  show @end
  connect @claim
  connect @retry
  connect @resume
  connect @exhaust
  connect @complete
  connect @cancel-running
  connect @cancel-wait
  connect @cancelled
  connect @finish-failed
  connect @finish-success
}
}
