  node @observe concept "1 · Observe" role=primary size=medium sources=[] {
  icon @symbol asset=@evidence size=large
  text @detail "Gather an example people can inspect."
}
  node @explain concept "2 · Explain" role=supporting size=medium sources=[] {
  icon @symbol asset=@lesson size=large
  text @detail "Connect the evidence to a useful principle."
}
  node @practice concept "3 · Practice" role=success size=medium sources=[] {
  icon @symbol asset=@shield size=large
  text @detail "Ask the learner to apply it in a new situation."
}
  node @source note "Show the source" role=neutral size=medium sources=[] {
  list @detail ["Who observed it?", "When and under what conditions?"]
}
  node @limit note "Name the limit" role=warning size=medium sources=[] {
  text @detail "Separate a supported claim from an assumption."
}
  node @transfer note "Test transfer" role=neutral size=medium sources=[] {
  text @detail "A new example shows understanding beyond recall."
}
  section @evidence-lesson "TEACHING / From evidence to understanding" mode=story columns=3 layout=grid gap=compact {
  group @observe-column "EVIDENCE" represents=@observe columns=1 layout=grid {
  show @source
}
  group @explain-column "MEANING" represents=@explain columns=1 layout=grid {
  show @limit
}
  group @practice-column "TRANSFER" represents=@practice columns=1 layout=grid {
  show @transfer
}
}
