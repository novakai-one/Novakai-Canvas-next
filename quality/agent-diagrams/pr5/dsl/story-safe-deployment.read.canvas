  text @detail "Expand only when guardrails remain green."
}
  node @unsafe note "Unsafe signal" role=warning size=small sources=[] {
  text @detail "Pause, roll back and preserve evidence."
}
  node @record note "Close the loop" role=neutral size=medium sources=[] {
