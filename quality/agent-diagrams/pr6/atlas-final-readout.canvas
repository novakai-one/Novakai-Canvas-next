  section @sequence-1-library-reservation "RESERVATION / Availability decides the path" mode=sequence order=9 layout=sequence direction=down gap=compact {
  show @sequence-1-reader
  show @sequence-1-catalog
  show @sequence-1-holds
  show @sequence-1-notice
  show @sequence-1-desk
  event @sequence-1-search @sequence-1-reader -> @sequence-1-catalog "Find a copy" activate=true
  event @sequence-1-status @sequence-1-catalog -> @sequence-1-reader "Return availability" kind=return activate=false
  fragment @sequence-1-availability alt "Reserve or wait" {
  branch @sequence-1-available "Copy available" {
  event @sequence-1-hold @sequence-1-reader -> @sequence-1-holds "Reserve copy" activate=true
  event @sequence-1-notify @sequence-1-holds -> @sequence-1-notice "Send confirmation" kind=async
  event @sequence-1-stage @sequence-1-holds -> @sequence-1-desk "Prepare pickup" kind=async
  event @sequence-1-confirmed @sequence-1-holds -> @sequence-1-reader "Return reservation receipt" kind=return activate=false
}
  branch @sequence-1-unavailable "No copy available" {
  event @sequence-1-queue @sequence-1-reader -> @sequence-1-holds "Join waitlist"
  event @sequence-1-queued @sequence-1-holds -> @sequence-1-reader "Return queue position" kind=return
}
}
}
  section @sequence-2-settlement "SETTLEMENT / Retry submission, confirm asynchronously" mode=sequence order=10 layout=sequence direction=down gap=compact {
  show @sequence-2-merchant
  show @sequence-2-payments
  show @sequence-2-ledger
  show @sequence-2-network
  show @sequence-2-webhook
  event @sequence-2-capture @sequence-2-merchant -> @sequence-2-payments "Capture authorized payment" activate=true
  event @sequence-2-pending @sequence-2-payments -> @sequence-2-ledger "Record pending settlement"
  fragment @sequence-2-attempts loop "Until accepted or retry limit" {
  event @sequence-2-submit @sequence-2-payments -> @sequence-2-network "Submit settlement batch" activate=true
  event @sequence-2-ack @sequence-2-network -> @sequence-2-payments "Return batch acceptance" kind=return activate=false
}
  event @sequence-2-accepted @sequence-2-payments -> @sequence-2-merchant "Return accepted receipt" kind=return activate=false
  event @sequence-2-callback @sequence-2-network -> @sequence-2-payments "Settlement completed callback" kind=async activate=true
  event @sequence-2-post @sequence-2-payments -> @sequence-2-ledger "Post final settlement"
  event @sequence-2-notify @sequence-2-payments -> @sequence-2-webhook "Publish settlement outcome" kind=async activate=false
}
  section @sequence-3-notification "NOTIFICATION / Deduplicate, optionally page, acknowledge" mode=sequence order=11 layout=sequence direction=down gap=compact {
  show @sequence-3-monitor
  show @sequence-3-incident
  show @sequence-3-directory
  show @sequence-3-pager
  show @sequence-3-responder
  event @sequence-3-report @sequence-3-monitor -> @sequence-3-incident "Report alert fingerprint" activate=true
  event @sequence-3-dedupe @sequence-3-incident -> @sequence-3-incident "Check deduplication window"
  fragment @sequence-3-page opt "New actionable incident" {
  event @sequence-3-lookup @sequence-3-incident -> @sequence-3-directory "Resolve current on-call" activate=true
  event @sequence-3-contact @sequence-3-directory -> @sequence-3-incident "Return contact route" kind=return activate=false
  event @sequence-3-send @sequence-3-incident -> @sequence-3-pager "Queue incident page" activate=true
  event @sequence-3-queued @sequence-3-pager -> @sequence-3-incident "Return delivery receipt" kind=return activate=false
  event @sequence-3-deliver @sequence-3-pager -> @sequence-3-responder "Deliver incident page" kind=async
}
  event @sequence-3-receipt @sequence-3-incident -> @sequence-3-monitor "Return incident identity" kind=return activate=false
  fragment @sequence-3-acknowledge opt "Responder accepts ownership" {
  event @sequence-3-ack @sequence-3-responder -> @sequence-3-incident "Acknowledge incident" activate=true
  event @sequence-3-record @sequence-3-incident -> @sequence-3-incident "Record owner and timestamp"
  event @sequence-3-confirmed @sequence-3-incident -> @sequence-3-responder "Confirm ownership" kind=return activate=false
}
}
