# grid-beta revision=1
canvas 1
collection @grid-beta "Compare incident learning formats" theme="paper@1.0.0#sha256:26f6c69a71213b2315ac1000f6dff35d82d819af11e11f6d00fc25696e5be094" layout=grid {
  node @guided concept "Facilitated review" role=primary size=medium sources=[] {
  text @summary "Reconstruct the incident together while evidence is fresh."
}
  node @guided-strength note "Fast shared understanding" role=success size=medium sources=[] {
  list @points ["Questions answered immediately", "Decisions made with the group"]
}
  node @guided-limit note "Needs a common time" role=warning size=medium sources=[] {
  text @detail "Record the outcome for anyone who cannot attend."
}
  node @self concept "Written reflection" role=supporting size=medium sources=[] {
  text @summary "Give each responder quiet time to record observations independently."
}
  node @self-strength note "Easy to revisit" role=success size=medium sources=[] {
  list @points ["Scales across time zones", "Supports individual pacing"]
}
  node @self-limit note "Questions arrive later" role=warning size=medium sources=[] {
  text @detail "Provide a clear feedback and escalation path."
}
  node @paired concept "Scenario replay" role=neutral size=medium sources=[] {
  text @summary "Walk through a similar event with a partner and test the response."
}
  node @paired-strength note "Immediate applied feedback" role=success size=medium sources=[] {
  list @points ["Exposes hidden assumptions", "Builds confidence through practice"]
}
  node @paired-limit note "Quality depends on the pairing" role=warning size=medium sources=[] {
  text @detail "Rotate partners and provide a worked reference."
}
  section @options "Incident learning formats at a glance" mode=grid columns=3 layout=grid gap=compact {
  group @guided-panel "GUIDED" represents=@guided columns=1 layout=grid gap=compact {
  show @guided-strength
  show @guided-limit
}
  group @self-panel "SELF-PACED" represents=@self columns=1 layout=grid gap=compact {
  show @self-strength
  show @self-limit
}
  group @paired-panel "PAIRED" represents=@paired columns=1 layout=grid gap=compact {
  show @paired-strength
  show @paired-limit
}
}
}