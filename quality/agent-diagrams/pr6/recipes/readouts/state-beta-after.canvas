# state-beta revision=1
canvas 1
collection @state-beta "Policy exception lifecycle" theme="paper@1.0.0#sha256:26f6c69a71213b2315ac1000f6dff35d82d819af11e11f6d00fc25696e5be094" layout=grid {
  node @start start "Proposal opened" role=neutral size=medium sources=[] {

}
  node @draft state "Drafting" role=primary size=medium sources=[] {
  text @detail "Capture the context, options and expected consequences."
}
  node @review state "Risk and owner review" role=supporting size=medium sources=[] {
  text @detail "Confirm the risk, compensating control and accountable owner."
}
  node @accepted state "Accepted" role=success size=medium sources=[] {
  text @detail "Publish the decision and assign follow-up work."
}
  node @withdrawn end "Withdrawn" role=warning size=medium sources=[] {

}
  wire @begin @start -> @draft "start proposal" kind=transition effect="name the owner" sources=[]
  wire @submit @draft -> @review "request review" kind=transition guard="options documented" sources=[]
  wire @revise @review -> @draft "revise proposal" kind=transition guard="changes requested" effect="record findings" sources=[]
  wire @approve @review -> @accepted "grant time-boxed exception" kind=transition guard="review complete" effect="publish record" sources=[]
  wire @withdraw @draft -> @withdrawn "withdraw proposal" kind=transition guard="decision no longer needed" sources=[]
  section @lifecycle "From exception request to accountable outcome" mode=state layout=layered {
  show @start
  show @draft
  show @review
  show @accepted
  show @withdrawn
  connect @begin
  connect @submit
  connect @revise
  connect @approve
  connect @withdraw
}
}