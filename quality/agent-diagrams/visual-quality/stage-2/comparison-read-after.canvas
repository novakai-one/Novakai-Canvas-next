# grid-research-methods revision=1
canvas 1
collection @grid-research-methods "Research methods evidence matrix" theme="studio@1.0.0#sha256:32c858278187e74523054d6799884b5790ba057815860168e76a91a1d369a9c1" description="Illustrative method selection aid; evidence strength depends on execution." layout=grid {
  asset @evidence image source="sha256:e8f93d29f128f74ec2c949cbffe8a3f6541dc57a42f114caccf94e1c1dda57a8" alt="Recorded research evidence"
  node @question concept "Start with the claim" role=primary size=medium frame=none composition=media-left sources=[] {
  icon @figure asset=@evidence size=small
  text @detail "Choose evidence that can challenge the claim." role=body
}
  node @experiment concept "Experiment" role=success size=medium frame=card composition=media-top sources=[] {
  icon @figure asset=@evidence size=small
  text @caption "Compare outcomes under an assigned change; record the comparison before interpreting the result." role=caption
  table @matrix columns=["Dimension", "Evidence"] {
  row @question cells=["Question", "Did a change affect an outcome?"]
  row @record cells=["Record", "Assigned groups and outcomes"]
  row @limit cells=["Limit", "Setting may constrain transfer"]
}
}
  node @cohort concept "Cohort study" role=supporting size=medium frame=none composition=media-top sources=[] {
  icon @figure asset=@evidence size=small
  text @caption "Observe a defined group over time." role=caption
  table @matrix columns=["Dimension", "Evidence"] {
  row @question cells=["Question", "What changes over time?"]
  row @record cells=["Record", "Repeated observations"]
  row @limit cells=["Limit", "Confounding and attrition"]
}
}
  node @case concept "Case study" role=neutral size=medium frame=auto composition=stack sources=[] {
  table @matrix columns=["Dimension", "Evidence"] {
  row @question cells=["Question", "How did this case unfold?"]
  row @record cells=["Record", "Documents and accounts"]
  row @limit cells=["Limit", "Case selection shapes scope"]
}
}
  node @synthesis concept "Evidence synthesis" role=neutral size=medium frame=auto composition=stack sources=[] {
  table @matrix columns=["Dimension", "Evidence"] {
  row @question cells=["Question", "What do studies agree on?"]
  row @record cells=["Record", "Included studies and quality"]
  row @limit cells=["Limit", "Missing or uneven studies"]
}
}
  node @causal note "Before a causal claim" role=warning size=medium frame=auto composition=stack sources=[] {
  list @checks ["Check the comparison", "Check assignment and missing data"]
}
  node @triangulate note "Combine complementary evidence" role=neutral size=medium frame=auto composition=stack sources=[] {
  text @detail "Use case context to interpret patterns; test explanations with new comparisons." role=body
}
  section @methods "Choosing research evidence" mode=grid columns=1 layout=grid gap=compact {
  group @primary "COLLECT PRIMARY EVIDENCE" frame=panel role=supporting columns=3 layout=grid gap=compact {
  show @experiment
  show @cohort
  show @case
}
  group @secondary "REUSE AND CHALLENGE" frame=panel role=neutral columns=2 layout=grid gap=compact {
  show @synthesis
  show @causal
  show @question
  show @triangulate
}
}
}