# flow-research-approval revision=2
canvas 1
collection @flow-research-approval "Research approval workflow" theme="atlas@1.0.0#sha256:be96a23d9903616dfbde6b26a427693cf1d2861d7200060dc9817122d1fb77d7" layout=grid {
  node @submit start "Protocol submitted" role=primary size=small frame=auto composition=stack sources=[] {

}
  node @triage step "Administrative triage" role=neutral size=medium frame=auto composition=stack sources=[] {
  text @detail "Confirm ownership, version and required documents." role=body
}
  node @split fork "Parallel review" role=supporting size=small frame=auto composition=stack sources=[] {

}
  node @ethics step "Ethics review" role=neutral size=large frame=auto composition=stack sources=[] {
  text @detail "Assess consent, risk and participant safeguards." role=body
}
  node @methods step "Methods review" role=neutral size=large frame=auto composition=stack sources=[] {
  text @detail "Assess design, sample and analysis plan." role=body
}
  node @merge join "Reviews complete" role=supporting size=small frame=auto composition=stack sources=[] {

}
  node @decision decision "Both reviews approve?" role=decision size=medium frame=auto composition=stack sources=[] {

}
  node @revise step "Revise protocol" role=warning size=medium frame=auto composition=stack sources=[] {
  text @detail "Resolve the consolidated requests before resubmission." role=body
}
  node @approved end "Approval recorded" role=success size=small frame=auto composition=stack sources=[] {

}
  wire @begin @submit -> @triage "open case" step=1 sources=[]
  wire @ready @triage -> @split "documents complete" step=2 sources=[]
  wire @ethics-path @split -> @ethics "review safeguards" step=3 sources=[]
  wire @methods-path @split -> @methods "review evidence plan" step=3 sources=[]
  wire @ethics-done @ethics -> @merge "ethics recommendation" sources=[]
  wire @methods-done @methods -> @merge "methods recommendation" sources=[]
  wire @decide @merge -> @decision "combine findings" step=4 sources=[]
  wire @accept @decision -> @approved "yes: record approval" sources=[]
  wire @changes @decision -> @revise "no: revise protocol" sources=[]
  wire @resubmit @revise -> @triage "resubmit new version" style=dashed sources=[]
  section @approval "RESEARCH APPROVAL / Independent review, one decision" layout=flow direction=down gap=roomy {
  show @submit
  show @triage
  show @split
  show @ethics
  show @methods
  show @merge
  show @decision
  show @revise
  show @approved
  connect @begin source-side=bottom target-side=top
  connect @ready source-side=bottom target-side=top
  connect @ethics-path
  connect @methods-path
  connect @ethics-done
  connect @methods-done
  connect @decide
  connect @accept
  connect @changes
  connect @resubmit source-side=right target-side=right
  rank @submit @triage @split @merge @decision
  align @ethics @methods
  before @split @ethics
  before @ethics @merge
  before @decision @approved
}
}