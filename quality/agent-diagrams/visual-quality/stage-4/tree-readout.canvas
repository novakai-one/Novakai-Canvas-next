# tree-field-research revision=2
canvas 1
collection @tree-field-research "Design a field study" theme="atlas@1.0.0#sha256:be96a23d9903616dfbde6b26a427693cf1d2861d7200060dc9817122d1fb77d7" layout=grid {
  node @study concept "Field study" role=primary size=medium frame=auto composition=stack sources=[] {
  text @detail "A question connected to observable evidence." role=body
}
  node @question concept "Question" role=neutral size=medium frame=auto composition=stack sources=[] {
  text @detail "What changes between the two habitats?" role=body
}
  node @sampling concept "Sampling" role=supporting size=medium frame=auto composition=stack sources=[] {

}
  node @sites concept "Sites" role=neutral size=medium frame=auto composition=stack sources=[] {
  list @detail ["Wetland edge", "Upstream reference"]
}
  node @timing concept "Timing" role=neutral size=medium frame=auto composition=stack sources=[] {
  text @detail "Repeat at dawn and after rainfall." role=body
}
  node @records concept "Records" role=success size=medium frame=auto composition=stack sources=[] {

}
  node @observations concept "Observations" role=neutral size=medium frame=auto composition=stack sources=[] {
  list @detail ["Species count", "Water clarity"]
}
  node @calibration concept "Calibration" role=neutral size=medium frame=auto composition=stack sources=[] {
  text @detail "Check the same reference before each visit." role=body
}
  node @context concept "Context" role=neutral size=medium frame=auto composition=stack sources=[] {
  list @detail ["Weather", "Observer", "Equipment"]
}
  wire @ask @study -> @question "defines" kind=parent sources=[]
  wire @plan @study -> @sampling "plans" kind=parent sources=[]
  wire @keep @study -> @records "retains" kind=parent sources=[]
  wire @where @sampling -> @sites "where" kind=parent sources=[]
  wire @when @sampling -> @timing "when" kind=parent sources=[]
  wire @measure @records -> @observations "measures" kind=parent sources=[]
  wire @explain @records -> @context "explains" kind=parent sources=[]
  wire @calibrate @context -> @calibration "standardizes" kind=parent sources=[]
  wire @answers @observations -> @question "answers" kind=reference style=dashed sources=[]
  section @field-research "FIELD STUDY / Make evidence comparable" mode=tree layout=tree gap=compact {
  show @study
  show @question
  show @sampling
  show @sites
  show @timing
  show @records
  show @observations
  show @context
  show @calibration
  connect @plan source-side=right target-side=left
  connect @ask source-side=bottom target-side=left
  connect @keep source-side=bottom target-side=left
  connect @where
  connect @when
  connect @measure
  connect @explain
  connect @calibrate
  connect @answers source-side=top target-side=top
  root @study
}
}