# flow-emergency-dispatch revision=0
canvas 1
collection @flow-emergency-dispatch "Emergency dispatch escalation" theme="atlas@1.0.0#sha256:be96a23d9903616dfbde6b26a427693cf1d2861d7200060dc9817122d1fb77d7" description="Illustrative dispatch software workflow, not operational emergency guidance." layout=grid {
  node @reported start "Incident reported" role=primary size=medium frame=auto composition=stack sources=[] {

}
  node @assess step "Classify incident" role=neutral size=medium frame=auto composition=stack sources=[] {
  text @detail "Record location, incident type and contact." role=body
}
  node @eligible decision "Dispatch required?" role=decision size=medium frame=auto composition=stack sources=[] {

}
  node @referred end "Referral recorded" role=supporting size=medium frame=auto composition=stack sources=[] {

}
  node @available decision "Unit available?" role=decision size=medium frame=auto composition=stack sources=[] {

}
  node @escalate step "Escalate to supervisor" role=warning size=medium frame=auto composition=stack sources=[] {
  text @detail "Request mutual aid and record the unmet need." role=body
}
  node @aid decision "Aid confirmed?" role=decision size=medium frame=auto composition=stack sources=[] {

}
  node @assign step "Assign responding unit" role=neutral size=medium frame=auto composition=stack sources=[] {
  text @detail "Send incident details and await acceptance." role=body
}
  node @accepted end "Response assigned" role=success size=medium frame=auto composition=stack sources=[] {

}
  node @unresolved end "Unresolved escalation" role=warning size=medium frame=auto composition=stack sources=[] {
  text @detail "Keep the incident open in the supervisor queue." role=body
}
  wire @open @reported -> @assess "open incident" sources=[]
  wire @classify @assess -> @eligible "classification ready" sources=[]
  wire @refer @eligible -> @referred "no: refer service" sources=[]
  wire @needed @eligible -> @available "yes: seek unit" sources=[]
  wire @local @available -> @assign "yes: local unit" sources=[]
  wire @shortage @available -> @escalate "no: resource gap" sources=[]
  wire @request @escalate -> @aid "check mutual aid" sources=[]
  wire @mutual @aid -> @assign "yes: aid unit" sources=[]
  wire @pending @aid -> @unresolved "no: retain ownership" sources=[]
  wire @dispatch @assign -> @accepted "unit accepts" sources=[]
  section @dispatch "DISPATCH / Escalation preserves incident ownership" layout=layered gap=compact {
  group @intake "TRIAGE" frame=auto role=neutral layout=layered direction=down gap=compact {
  show @reported
  show @assess
  show @eligible
  show @referred
}
  group @response "FIND A RESPONSE" frame=auto role=neutral layout=layered direction=down gap=compact {
  show @available
  show @escalate
  show @aid
  show @unresolved
}
  group @handoff "TRANSFER OWNERSHIP" frame=auto role=neutral layout=layered direction=down gap=compact {
  show @assign
  show @accepted
}
  connect @open
  connect @classify
  connect @refer
  connect @needed
  connect @local
  connect @shortage
  connect @request
  connect @mutual
  connect @pending
  connect @dispatch
}
}