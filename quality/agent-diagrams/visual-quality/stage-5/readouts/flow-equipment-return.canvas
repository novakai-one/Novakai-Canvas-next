# flow-equipment-return revision=0
canvas 1
collection @flow-equipment-return "Return equipment safely" theme="atlas@1.0.0#sha256:be96a23d9903616dfbde6b26a427693cf1d2861d7200060dc9817122d1fb77d7" layout=grid {
  node @receive step "1 · Receive" role=primary size=medium frame=auto composition=stack sources=[] {
  text @detail "Record the item and its borrower." role=body
}
  node @inspect decision "Safe to reuse?" role=neutral size=medium frame=auto composition=stack sources=[] {
  text @detail "Inspect before closing the loan." role=body
}
  node @service step "Repair" role=warning size=medium frame=auto composition=stack sources=[] {
  text @detail "Quarantine and record the defect." role=body
}
  node @clean step "2 · Clean" role=neutral size=medium frame=auto composition=stack sources=[] {
  text @detail "Prepare the kit for its next user." role=body
}
  node @restock step "3 · Restock" role=success size=medium frame=auto composition=stack sources=[] {
  text @detail "Return all parts to the assigned shelf." role=body
}
  node @receipt end "Loan closed" role=success size=medium frame=auto composition=stack sources=[] {

}
  wire @check @receive -> @inspect "inspect" sources=[]
  wire @fail @inspect -> @service "no" sources=[]
  wire @retry @service -> @inspect "recheck" sources=[]
  wire @pass @inspect -> @clean "yes" sources=[]
  wire @ready @clean -> @restock "dry and complete" sources=[]
  wire @close @restock -> @receipt "issue receipt" sources=[]
  section @equipment-return "RETURN / Inspect before restocking" layout=flow direction=down gap=compact {
  show @receive
  show @inspect
  show @service
  show @clean
  show @restock
  show @receipt
  connect @check
  connect @fail
  connect @pass
  connect @ready
  connect @close
  connect @retry source-side=right target-side=right
}
}