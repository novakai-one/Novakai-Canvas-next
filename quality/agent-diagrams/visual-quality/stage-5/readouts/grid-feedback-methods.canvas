  node @interview concept "Interview" role=primary size=large frame=none composition=media-top sources=[] {
  image @symbol asset=@lesson size=medium
  text @detail "Ask why a recent moment mattered." role=body
}
  node @interview-use note "Rich explanation · low scale" role=neutral size=small frame=auto composition=stack sources=[] {
  text @tip "Use after a specific experience, not for predictions." role=body
}
  node @survey concept "Survey" role=supporting size=large frame=none composition=media-top sources=[] {
  image @symbol asset=@evidence size=medium
  text @detail "Measure a known question across many people." role=body
}
  node @survey-use note "Broad pattern · fixed questions" role=neutral size=small frame=auto composition=stack sources=[] {
  text @tip "Pilot wording before comparing responses." role=body
}
  node @observation concept "Observation" role=success size=large frame=none composition=media-top sources=[] {
  image @symbol asset=@reed size=medium
  text @detail "Watch real work in its normal setting." role=body
}
  node @observation-use note "Real behavior · slower analysis" role=neutral size=small frame=auto composition=stack sources=[] {
  text @tip "Record context as well as actions." role=body
}
  node @telemetry concept "Telemetry" role=warning size=large frame=none composition=media-top sources=[] {
  image @symbol asset=@water size=medium
  text @detail "Track what happened at product scale." role=body
}
  node @telemetry-use note "Continuous signal · weak intent" role=neutral size=small frame=auto composition=stack sources=[] {
  text @tip "Pair behavior with a method that explains why." role=body
}
  section @feedback-grid "FEEDBACK METHODS / Match the method to the question" mode=grid columns=2 layout=grid gap=compact {
  group @explain "EXPLAIN" represents=@interview frame=panel role=neutral columns=1 layout=grid gap=compact {
  show @interview-use
}
  group @measure "MEASURE" represents=@survey frame=panel role=neutral columns=1 layout=grid gap=compact {
  show @survey-use
}
  group @observe "OBSERVE" represents=@observation frame=panel role=neutral columns=1 layout=grid gap=compact {
  show @observation-use
}
  group @monitor "MONITOR" represents=@telemetry frame=panel role=neutral columns=1 layout=grid gap=compact {
  show @telemetry-use
}
}
