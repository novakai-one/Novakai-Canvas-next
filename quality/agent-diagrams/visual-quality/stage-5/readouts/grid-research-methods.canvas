# grid-research-methods revision=3
canvas 1
collection @grid-research-methods "Choose evidence for the claim" theme="studio@1.0.1#sha256:b7c632906dc67c69671c0f8661f43a261bab0d6c1545ddadf6974eea96c5f78a" description="Illustrative method selection aid; evidence strength depends on execution." layout=grid {
  asset @evidence image source="sha256:e8f93d29f128f74ec2c949cbffe8a3f6541dc57a42f114caccf94e1c1dda57a8" alt="Inspectable evidence for a research claim"
  node @question concept "What claim must the evidence support?" role=neutral size=medium frame=none composition=media-left sources=[] {
  image @figure asset=@evidence size=small
  text @caption "Compare the same dimensions across methods. No method removes the need to inspect how the work was done." role=caption
}
  node @matrix concept "Four ways to build evidence" role=neutral size=large frame=card composition=stack sources=[] {
  table @comparison columns=["Method", "Question", "Record", "Watch for"] {
  row @experiment cells=["Experiment", "Did the assigned change affect an outcome?", "Groups, assignment and outcomes", "Setting may limit transfer"]
  row @cohort cells=["Cohort study", "What changes over time?", "Repeated observations of a defined group", "Confounding and attrition"]
  row @case cells=["Case study", "How did this case unfold?", "Documents, observations and accounts", "Case selection shapes scope"]
  row @synthesis cells=["Evidence synthesis", "What do studies agree on?", "Included studies and quality checks", "Missing or uneven studies"]
}
}
  node @causal note "Before a causal claim" role=warning size=medium frame=card composition=stack sources=[] {
  list @checks ["Check the comparison", "Check assignment and missing data", "Consider alternative explanations"]
}
  node @triangulate note "Combine complementary evidence" role=success size=medium frame=card composition=stack sources=[] {
  text @caption "Use case context to interpret a pattern; challenge the explanation with a new comparison." role=caption
}
  section @methods "Choosing research evidence" mode=grid columns=1 layout=grid direction=down {
  show @question
  show @matrix
  group @interpretation "INTERPRET BEFORE YOU CONCLUDE" frame=none role=neutral columns=2 layout=grid {
  show @causal
  show @triangulate
}
  before @question @matrix
  before @matrix group:@interpretation
}
}