# sequence-library-reservation revision=0
canvas 1
collection @sequence-library-reservation "Library reservation conversation" theme="atlas@1.0.0#sha256:be96a23d9903616dfbde6b26a427693cf1d2861d7200060dc9817122d1fb77d7" layout=grid {
  node @reader participant "Reader" role=primary size=medium frame=auto composition=stack sources=[] {

}
  node @catalog participant "Catalog" role=neutral size=medium frame=auto composition=stack sources=[] {

}
  node @holds participant "Reservations" role=supporting size=large frame=auto composition=stack sources=[] {

}
  node @notice participant "Notifications" role=neutral size=small frame=auto composition=stack sources=[] {

}
  node @desk participant "Pickup desk" role=success size=medium frame=auto composition=stack sources=[] {

}
  section @library-reservation "RESERVATION / Availability decides the path" mode=sequence layout=sequence direction=down gap=compact {
  show @reader
  show @catalog
  show @holds
  show @notice
  show @desk
  event @search @reader -> @catalog "Find a copy" activate=true
  event @status @catalog -> @reader "Return availability" kind=return activate=false
  fragment @availability alt "Reserve or wait" {
  branch @available "Copy available" {
  event @hold @reader -> @holds "Reserve copy" activate=true
  event @notify @holds -> @notice "Send confirmation" kind=async
  event @stage @holds -> @desk "Prepare pickup" kind=async
  event @confirmed @holds -> @reader "Return reservation receipt" kind=return activate=false
}
  branch @unavailable "No copy available" {
  event @queue @reader -> @holds "Join waitlist"
  event @queued @holds -> @reader "Return queue position" kind=return
}
}
}
}