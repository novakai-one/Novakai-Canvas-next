# state-exhibition-lifecycle revision=4
canvas 1
collection @state-exhibition-lifecycle "Exhibition publication lifecycle" theme="atlas@1.0.0#sha256:be96a23d9903616dfbde6b26a427693cf1d2861d7200060dc9817122d1fb77d7" layout=grid {
  node @start start "Begin" role=neutral size=small frame=auto composition=stack sources=[] {

}
  node @draft state "Draft" role=primary size=medium frame=auto composition=stack sources=[] {
  text @detail "Objects and interpretation are still changing." role=body
}
  node @review state "Under review" role=supporting size=large frame=auto composition=stack sources=[] {
  text @detail "Curatorial and rights checks run together." role=body
}
  node @published state "Published" role=success size=medium frame=auto composition=stack sources=[] {
  text @detail "The approved exhibition is visible." role=body
}
  node @rollback state "Rollback pending" role=warning size=large frame=auto composition=stack sources=[] {
  text @detail "Restore the last approved release and preserve evidence." role=body
}
  node @withdrawn state "Withdrawn" role=warning size=medium frame=auto composition=stack sources=[] {
  text @detail "Public access is disabled with a recorded reason." role=body
}
  node @end end "Closed" role=neutral size=small frame=auto composition=stack sources=[] {

}
  wire @prepare @start -> @draft "create draft" kind=transition effect="open working version" sources=[]
  wire @submit @draft -> @review "submit for review" kind=transition guard="required material complete" sources=[]
  wire @revise @review -> @draft "request revision" kind=transition guard="changes requested" effect="record findings" sources=[]
  wire @publish @review -> @published "publish approved release" kind=transition guard="curator and rights approved" effect="pin release" sources=[]
  wire @detect @published -> @rollback "begin rollback" kind=transition guard="material defect found" effect="freeze affected release" sources=[]
  wire @restore @rollback -> @published "restore prior release" kind=transition guard="safe release available" effect="record rollback receipt" sources=[]
  wire @withdraw @rollback -> @withdrawn "withdraw exhibition" kind=transition guard="no safe release" effect="post public notice" sources=[]
  wire @close @withdrawn -> @end "close record" kind=transition guard="retention captured" sources=[]
  section @lifecycle "EXHIBITION / Guard publication and recover safely" mode=state layout=layered direction=down gap=roomy {
  show @end
  group @authoring "PREPARE & APPROVE" frame=auto role=neutral layout=layered gap=roomy {
  show @start
  show @draft
  show @review
  rank @start @draft @review
}
  group @publication "PUBLISH & RECOVER" frame=auto role=neutral layout=layered gap=roomy {
  show @published
  show @rollback
  show @withdrawn
  rank @published @rollback @withdrawn
}
  connect @prepare source-side=right target-side=left
  connect @submit source-side=right target-side=left
  connect @detect source-side=right target-side=left
  connect @withdraw source-side=right target-side=left
  connect @revise source-side=bottom target-side=bottom
  connect @restore source-side=bottom target-side=bottom
  connect @publish source-side=bottom target-side=left
  connect @close source-side=bottom target-side=right
}
}