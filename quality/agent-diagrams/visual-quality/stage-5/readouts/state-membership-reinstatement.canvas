# state-membership-reinstatement revision=1
canvas 1
collection @state-membership-reinstatement "Membership reinstatement" theme="atlas@1.0.0#sha256:be96a23d9903616dfbde6b26a427693cf1d2861d7200060dc9817122d1fb77d7" description="Illustrative club policy: review restores access; closure is final." layout=grid {
  node @start start "Application" role=neutral size=medium frame=auto composition=stack sources=[] {

}
  node @pending state "Pending approval" role=supporting size=medium frame=auto composition=stack sources=[] {

}
  node @active state "Active" role=success size=medium frame=auto composition=stack sources=[] {
  text @detail "Member privileges are enabled." role=body
}
  node @suspended state "Suspended" role=warning size=medium frame=auto composition=stack sources=[] {
  text @detail "Privileges paused; history retained." role=body
}
  node @review state "Reinstatement review" role=primary size=medium frame=auto composition=stack sources=[] {
  text @detail "Verify the remedy and reviewer decision." role=body
}
  node @restored state "Reinstated" role=success size=medium frame=auto composition=stack sources=[] {
  text @detail "Access restored with a monitored review period." role=body
}
  node @closed end "Closed" role=neutral size=medium frame=auto composition=stack sources=[] {

}
  wire @submit @start -> @pending "submit application" kind=transition effect="record applicant" sources=[]
  wire @approve @pending -> @active "approve" kind=transition guard="eligibility confirmed" effect="enable privileges" sources=[]
  wire @decline @pending -> @closed "decline" kind=transition guard="ineligible" effect="retain decision" sources=[]
  wire @suspend @active -> @suspended "suspend" kind=transition guard="policy breach upheld" effect="pause privileges" sources=[]
  wire @appeal @suspended -> @review "request reinstatement" kind=transition guard="remedy submitted" sources=[]
  wire @reject @review -> @suspended "request more evidence" kind=transition guard="remedy incomplete" sources=[]
  wire @restore @review -> @restored "approve reinstatement" kind=transition guard="remedy verified" effect="restore privileges" sources=[]
  wire @complete @restored -> @active "complete review period" kind=transition guard="conditions met" sources=[]
  wire @relapse @restored -> @suspended "suspend again" kind=transition guard="conditions breached" sources=[]
  wire @withdraw @suspended -> @closed "withdraw membership" kind=transition guard="member requests closure" sources=[]
  section @membership "MEMBERSHIP / Reinstatement is a reviewed return" mode=state layout=layered direction=down gap=compact {
  group @application "APPLICATION" frame=auto role=neutral layout=layered gap=compact {
  show @start
  show @pending
  rank @start @pending
}
  group @membership "ACTIVE MEMBERSHIP" frame=auto role=neutral layout=layered gap=compact {
  show @active
  show @restored
  rank @active @restored
}
  group @reviewing "REVIEW & CLOSURE" frame=auto role=neutral layout=layered gap=compact {
  show @suspended
  show @review
  show @closed
  rank @suspended @review @closed
}
  connect @submit
  connect @approve
  connect @suspend
  connect @appeal
  connect @restore
  connect @complete
  connect @relapse
  connect @withdraw
  connect @decline source-side=right target-side=top
  connect @reject source-side=bottom target-side=bottom
}
}