# story-water-treatment revision=7
canvas 1
collection @story-water-treatment "How water treatment uses several barriers" theme="studio@1.0.1#sha256:b7c632906dc67c69671c0f8661f43a261bab0d6c1545ddadf6974eea96c5f78a" description="Simplified conventional treatment explanation. Actual barriers and operating limits depend on source-water risks; this is not an operating procedure." layout=grid {
  asset @screen image source="sha256:aaf62277099d47da36908283e3748e72237b62bc02cc1fba7623b7c28d8e666d" alt="A coarse screen intercepts debris in an incoming water channel"
  asset @basin image source="sha256:b75917a4ec4a27eed4e9484dc994c3c76117a2f2598c4d8d9a5d4c53418b3185" alt="Particles gather and settle in a treatment basin"
  asset @filter image source="sha256:e891b6246d0bf487fbfa4233bc8de15d3cdb3138c822ea0829d4ccb811896846" alt="Water passes through layered filter media"
  asset @control image source="sha256:672e85d778baf6e6b07a45cd45b65b24bad935224e03c97ced9401e8f2380701" alt="A controlled treatment stage protects the water stream"
  asset @storage image source="sha256:9732b0c4e25ec4070f603e3d7eef0a6412d7fac778ba55df46ce3f188e5fd202" alt="Protected storage supplies the distribution network"
  asset @evidence image source="sha256:e8f93d29f128f74ec2c949cbffe8a3f6541dc57a42f114caccf94e1c1dda57a8" alt="Recorded observations used to check treatment"
  node @source concept "Screen the intake" role=neutral size=medium frame=none composition=media-top sources=[] {
  image @figure asset=@screen size=large
  text @detail "Intercept large debris before treatment." role=caption
}
  node @settle concept "Gather and settle" role=neutral size=medium frame=none composition=media-top sources=[] {
  image @figure asset=@basin size=large
  text @detail "Gather fine particles into floc that can settle." role=caption
}
  node @filter concept "Filter the water" role=neutral size=medium frame=none composition=media-top sources=[] {
  image @figure asset=@filter size=large
  text @detail "Pass clarified water through filter media." role=caption
}
  node @disinfect concept "Apply disinfection" role=neutral size=medium frame=none composition=media-top sources=[] {
  image @figure asset=@control size=large
  text @detail "Apply the selected, controlled disinfection barrier." role=caption
}
  node @supply concept "Protect distribution" role=neutral size=medium frame=none composition=media-top sources=[] {
  image @figure asset=@storage size=large
  text @detail "Protect treated water in storage and the network." role=caption
}
  node @barrier-system concept "02 / TREAT THE WATER" role=neutral size=medium frame=auto composition=stack sources=[] {

}
  node @monitor note "Check performance" role=neutral size=medium frame=none composition=media-top sources=[] {
  image @figure asset=@evidence size=small
  text @detail "Samples and instruments check filtration and disinfection." role=caption
  text @legend "Dashed arrows = monitoring, not water transport." role=annotation
}
  node @residuals note "Separate residuals" role=warning size=medium frame=card composition=stack sources=[] {
  text @detail "Settled solids and filter wash water require separate handling." role=caption
}
  node @limits note "One barrier is not enough" role=success size=medium frame=card composition=stack sources=[] {
  text @detail "Each stage addresses a different part of the source-water risk." role=caption
  text @scope "The source determines the necessary barriers and operating limits." role=annotation
}
  wire @intake @source -> @settle "screened source water" step=1 sources=[]
  wire @clarified @settle -> @filter "clarified water" step=2 sources=[]
  wire @filtered @filter -> @disinfect "filtered water" step=3 sources=[]
  wire @treated @disinfect -> @supply "treated water" step=4 sources=[]
  wire @solids @settle -> @residuals "settled solids" sources=[]
  wire @wash @filter -> @residuals "filter wash water" sources=[]
  wire @barrier-check @monitor -> @barrier-system "checks both barriers" kind=reference style=dashed sources=[]
  section @treatment "Water treatment" mode=story columns=2 layout=grid {
  group @train "A SEQUENCE OF BARRIERS" frame=none role=neutral columns=1 layout=grid direction=down {
  group @intake-stage "01 / REMOVE PARTICLES" frame=panel role=supporting columns=2 layout=grid {
  show @source
  show @settle
}
  group @barriers "02 / TREAT THE WATER" represents=@barrier-system frame=panel role=success columns=2 layout=grid {
  show @disinfect
  show @filter
}
  group @delivery "03 / KEEP IT PROTECTED" frame=panel role=neutral columns=2 layout=grid {
  show @supply
  show @limits
}
}
  group @oversight "OBSERVE + HANDLE SIDE STREAMS" frame=panel role=decision columns=1 layout=grid direction=down gap=roomy {
  show @monitor
  show @residuals
}
  connect @intake source-side=right target-side=left
  connect @clarified source-side=bottom target-side=top
  connect @filtered source-side=left target-side=right
  connect @treated source-side=bottom target-side=top
  connect @solids source-side=right target-side=left
  connect @wash source-side=right target-side=left
  connect @barrier-check source-side=bottom target-side=right
}
}