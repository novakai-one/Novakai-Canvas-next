# tree-course-objectives revision=1
canvas 1
collection @tree-course-objectives "Course learning objectives" theme="atlas@1.0.0#sha256:be96a23d9903616dfbde6b26a427693cf1d2861d7200060dc9817122d1fb77d7" layout=grid {
  node @course concept "Design reliable services" role=primary size=large frame=auto composition=stack sources=[] {
  text @detail "Learners move from recognition to defensible operation." role=body
}
  node @model concept "Model the system" role=supporting size=medium frame=auto composition=stack sources=[] {

}
  node @boundaries concept "Identify boundaries" role=neutral size=small frame=auto composition=stack sources=[] {
  text @detail "Name responsibilities and dependencies." role=body
}
  node @invariants concept "State invariants" role=neutral size=small frame=auto composition=stack sources=[] {
  text @detail "Describe what must remain true." role=body
}
  node @verify concept "Verify behavior" role=success size=medium frame=auto composition=stack sources=[] {

}
  node @tests concept "Design tests" role=neutral size=medium frame=auto composition=stack sources=[] {
  list @detail ["Happy path", "Failure path", "Recovery path"]
}
  node @evidence concept "Interpret evidence" role=neutral size=small frame=auto composition=stack sources=[] {
  text @detail "Separate observations from assumptions." role=body
}
  node @operate concept "Operate safely" role=warning size=medium frame=auto composition=stack sources=[] {

}
  node @respond concept "Respond to failure" role=neutral size=medium frame=auto composition=stack sources=[] {
  text @detail "Detect, contain, recover and learn." role=body
}
  node @communicate concept "Communicate decisions" role=neutral size=small frame=auto composition=stack sources=[] {
  text @detail "Record tradeoffs for the next operator." role=body
}
  wire @learn-model @course -> @model "learns to" kind=parent sources=[]
  wire @learn-verify @course -> @verify "learns to" kind=parent sources=[]
  wire @learn-operate @course -> @operate "learns to" kind=parent sources=[]
  wire @model-boundaries @model -> @boundaries "decomposes into" kind=parent sources=[]
  wire @model-invariants @model -> @invariants "makes explicit" kind=parent sources=[]
  wire @verify-tests @verify -> @tests "demonstrates with" kind=parent sources=[]
  wire @verify-evidence @verify -> @evidence "reasons from" kind=parent sources=[]
  wire @operate-respond @operate -> @respond "practises" kind=parent sources=[]
  wire @operate-communicate @operate -> @communicate "supports with" kind=parent sources=[]
  section @objectives "COURSE OBJECTIVES / From concepts to observable outcomes" mode=tree layout=tree gap=compact {
  show @course
  show @model
  show @boundaries
  show @invariants
  show @verify
  show @tests
  show @evidence
  show @operate
  show @respond
  show @communicate
  connect @learn-model source-side=right target-side=left
  connect @learn-verify source-side=right target-side=left
  connect @learn-operate source-side=right target-side=left
  connect @model-boundaries source-side=right target-side=left
  connect @model-invariants source-side=right target-side=left
  connect @verify-tests source-side=right target-side=left
  connect @verify-evidence source-side=right target-side=left
  connect @operate-respond source-side=right target-side=left
  connect @operate-communicate source-side=right target-side=left
  root @course
}
