canvas 1
collection @composition-lab "COMPOSITION LAB / A museum, a library, a decision" theme=paper layout=grid columns=2 gap=roomy description="Original DSL composition probes. Geometry is automatic. These are illustrative systems, not extracted source architecture." {
  node @artifact entity "Artifact" role=primary {
    field @id "artifact_id" type="ArtifactId" key=primary
    field @title "title" type="string"
    field @period "period" type="Period"
  }
  node @museum entity "Museum" role=primary {
    field @id "museum_id" type="MuseumId" key=primary
    field @name "name" type="string"
  }
  node @loan entity "Loan" {
    field @id "loan_id" type="LoanId" key=primary
    field @museum "borrower_id" type="MuseumId" key=foreign references=@museum.@id
    field @due "due_date" type="Date"
  }
  node @loan-item entity "Loan item" role=supporting {
    field @loan "loan_id" type="LoanId" key=foreign references=@loan.@id
    field @artifact "artifact_id" type="ArtifactId" key=foreign references=@artifact.@id
    keygroup @identity kind=primary fields=[@loan,@artifact]
  }
  node @inspection entity "Inspection" role=success {
    field @id "inspection_id" type="InspectionId" key=primary
    field @artifact "artifact_id" type="ArtifactId" key=foreign references=@artifact.@id
    field @condition "condition" type="Condition"
  }
  wire @borrows @museum.@id -> @loan.@museum "borrows" kind=association from=1 to=0..many
  wire @includes @loan.@id -> @loan-item.@loan "includes" kind=association from=1 to=1..many
  wire @travels @artifact.@id -> @loan-item.@artifact "travels on" kind=association from=1 to=0..many
  wire @checked @artifact.@id -> @inspection.@artifact "checked by" kind=association from=1 to=0..many
  section @museum-loans "MUSEUM LOANS / Trace every movement" mode=er layout=layered direction=right gap=compact order=0 {
    show @museum @loan @artifact @loan-item @inspection
    connect @borrows @includes @travels @checked
  }
  node @reader participant "Reader" role=primary {}
  node @catalog participant "Catalog" {}
  node @holds participant "Reservations" role=supporting {}
  node @notice participant "Notifications" {}
  node @desk participant "Pickup desk" role=success {}
  section @library-reservation "RESERVATION / Availability decides the path" mode=sequence direction=down gap=compact order=1 {
    show @reader @catalog @holds @notice @desk
    event @search @reader -> @catalog "Find a copy" kind=call activate=true
    event @status @catalog -> @reader "Availability" kind=return activate=false
    fragment @availability alt "Reserve or wait" {
      branch @available "Copy available" {
        event @hold @reader -> @holds "Reserve copy" kind=call activate=true
        event @notify @holds -> @notice "Send confirmation" kind=async
        event @stage @holds -> @desk "Prepare pickup" kind=async
        event @confirmed @holds -> @reader "Reservation confirmed" kind=return activate=false
      }
      branch @unavailable "No copy available" {
        event @queue @reader -> @holds "Join waitlist" kind=call
        event @queued @holds -> @reader "Queue position" kind=return
      }
    }
  }
  node @local-policy concept "Local archive" role=primary { text @purpose "Keep the original close to the curator." }
  node @local-speed concept "Fast to inspect" { list @points ["No network dependency", "Immediate full-resolution access"] }
  node @local-risk note "One building is one failure domain" role=warning { text @risk "Arrange an independent backup." }
  node @shared-policy concept "Shared repository" role=supporting { text @purpose "Give partner museums one catalog." }
  node @shared-access concept "Easy to collaborate" { list @points ["Shared identifiers", "Consistent access policy"] }
  node @shared-risk note "Availability depends on the service" role=warning { text @risk "Keep an offline inventory." }
  node @hybrid-policy concept "Hybrid archive" role=success { text @purpose "Combine local originals and shared discovery." }
  node @hybrid-access concept "Resilient discovery" { list @points ["Local preservation copy", "Shared searchable metadata"] }
  node @hybrid-risk note "Synchronization needs ownership" role=warning { text @risk "Name the authoritative record." }
  section @archive-comparison "ARCHIVE OPTIONS / Choose by the failure you can tolerate" mode=grid layout=grid columns=2 gap=compact order=2 {
    group @options "Three operating models" layout=grid columns=3 gap=compact {
      group @local "LOCAL" represents=@local-policy layout=grid columns=1 gap=compact { show @local-speed @local-risk }
      group @shared "SHARED" represents=@shared-policy layout=grid columns=1 gap=compact { show @shared-access @shared-risk }
      group @hybrid "HYBRID" represents=@hybrid-policy layout=grid columns=1 gap=compact { show @hybrid-access @hybrid-risk }
    }
  }
}
