canvas 2
declare @flow-model {
  node @receive step "Receive"
  node @ship step "Ship"
  wire @f1 @receive -> @ship kind=flow effect="callsSecret()"
}
collection @reject-flow-effect "Rejected flow effect" uses=@flow-model {
  section @s-flow "Fulfil" mode=flow {
    show @receive @ship
    connect @f1
  }
}
