canvas 2
declare @modules-model {
  node @routes module "routes.ts"
  node @orders module "orders.ts"
  wire @r @routes -> @orders kind=reference guard="calls chargeCard()"
}
collection @reject-reference-guard "Rejected reference guard" uses=@modules-model {
  section @s-mod "Imports" mode=modules {
    show @routes @orders
    connect @r
  }
}
