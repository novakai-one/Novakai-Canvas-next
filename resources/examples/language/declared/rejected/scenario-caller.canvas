canvas 2
declare @d {
  node @user participant "User"
  node @Order entity {
    field @id: string key=primary
  }
  node @orders module "orders.ts" {
    signature @placeOrder parameters=["lines": string] returns=string
  }
  node @pricing module "pricing.ts" {
    signature @priceOrder parameters=["lines": string] returns=string
  }
  scenario @place "Place an order" {
    call @Order -> @orders.@placeOrder
  }
}
collection @reject-scenario-caller "Rejected scenario caller" uses=@d {
  section @s "Place order" mode=sequence { show @place }
}
