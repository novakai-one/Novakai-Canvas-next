canvas 2
declare @state-model {
  node @draft state "Draft"
  node @placed state "Placed"
  wire @t1 @draft -> @placed kind=transition from=1
}
collection @reject-transition-from "Rejected transition from" uses=@state-model {
  section @s-state "Order states" mode=state {
    show @draft @placed
    connect @t1
  }
}
