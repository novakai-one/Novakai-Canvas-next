canvas 2
declare @ordering-model {
  type @Money @OrderId @CustomerId
  type @OrderStatus = 'draft' | 'placed' | 'fulfilled'
  node @Customer entity {
    field @id: @CustomerId key=primary
    field @name: string
  }
  node @Order entity {
    field @id: @OrderId key=primary
    field @customerId: @CustomerId
    field @status: @OrderStatus
    field @total: @Money
  }
  node @shop folder "shop/"
  node @ordering folder "ordering/"
  node @orders module "orders.ts" {
    signature @getOrder parameters=["id": @OrderId] returns=@Order
  }
  node @pricing module "pricing.ts" {
    signature @priceOrder parameters=["order": @Order] returns=@Money
  }
  node @draft start "Draft"
  node @placed state
  node @fulfilled end "Fulfilled"
  node @receive step "Receive order"
  node @check decision "In stock?"
  node @ship step "Ship"
  node @backorder step "Backorder"
  node @goals concept "Goals"
  node @risks concept "Risks"
  node @scope concept "Scope"
  node @problem concept "The problem"
  node @approach concept "The approach"
  node @outcome concept "The outcome"
  node @shopper participant "Shopper"
  wire @i1 @orders -> @pricing.@priceOrder kind=imports
  wire @owns @Customer.@id -> @Order.@customerId kind=association from=1 to=0..many
  wire @t1 @draft -> @placed kind=transition guard="placed"
  wire @t2 @placed -> @fulfilled kind=transition guard="shipped"
  wire @f1 @receive -> @check kind=flow
  wire @f2 @check -> @ship "yes" kind=flow
  wire @f3 @check -> @backorder "no" kind=flow
  scenario @reprice "Reprice an order" {
    call @shopper -> @orders.@getOrder returns
    alt "priced" { call @orders -> @pricing.@priceOrder returns }
    alt "no price" { call @orders -> @pricing.@priceOrder }
  }
  change @cycle-1 "Pricing rework" {
    new @pricing
    changed @orders.@getOrder
  }
}
collection @v2-all-modes "Ordering from every angle" uses=@ordering-model {
  section @s-tree "Repo tree" mode=tree {
    show @shop { show @ordering { show @orders @pricing } }
  }
  section @s-mod "Imports" mode=modules {
    show @ordering { show @orders @pricing }
    connect @i1
  }
  section @s-er "Data" mode=er {
    show @Customer @Order
    connect @owns
  }
  section @s-state "Order lifecycle" mode=state {
    show @draft @placed @fulfilled
    connect @t1 @t2
  }
  section @s-flow "Fulfilment" mode=flow {
    show @receive @check @ship @backorder
    connect @f1 @f2 @f3
  }
  section @s-grid "Board" mode=grid { show @goals @risks @scope }
  section @s-story "Narrative" mode=story { show @problem @approach @outcome }
  section @s-seq "Reprice" mode=sequence { show @reprice }
}
