canvas 2
declare @commerce-model {
  type @CustomerId @OrderId @LineId @ProductId @InvoiceId @Money
  node @Customer entity {
    field @id: @CustomerId key=primary
    field @email: string key=unique
  }
  node @Address entity {
    field @customerId: @CustomerId key=foreign references=@Customer.@id
    field @city: string
  }
  node @Order entity {
    field @id: @OrderId key=primary
    field @customerId: @CustomerId key=foreign references=@Customer.@id
    field @total: @Money
  }
  node @OrderLine entity {
    field @id: @LineId key=primary
    field @orderId: @OrderId key=foreign references=@Order.@id
    field @productId: @ProductId
    field @qty: number
  }
  node @Product entity {
    field @id: @ProductId key=primary
    field @price: @Money
  }
  node @Invoice entity {
    field @id: @InvoiceId key=primary
    field @orderId: @OrderId key=foreign references=@Order.@id
    field @paid: boolean
  }
  wire @stocks @Product.@id -> @OrderLine.@productId kind=association from=1 to=0..many
}
collection @v2-er-three "Commerce data, three views" uses=@commerce-model {
  section @s-customers "Customers" mode=er {
    show @Customer @Address @Order
    connect @fk-Address-customerId @fk-Order-customerId
  }
  section @s-orders "Orders" mode=er {
    show @Order @OrderLine @Product
    connect @fk-OrderLine-orderId @stocks
  }
  section @s-billing "Billing" mode=er {
    show @Order @Invoice
    connect @fk-Invoice-orderId
  }
}
