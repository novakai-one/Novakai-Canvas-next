canvas 2
declare @er-model {
  node @Customer entity {
    field @id: string key=primary
    field @email: string
  }
  node @Order entity {
    field @id: string key=primary
    field @customerId: string
  }
  wire @places @Customer.@id -> @Order.@customerId kind=association from=1 to=0..many
}
collection @v2-er "Data" uses=@er-model {
  section @s-er "Entities" mode=er { show @Customer @Order connect @places }
}
