canvas 2
declare @modules-model {
  type @Result
  node @api folder "api/"
  node @core folder "core/"
  node @routes module "routes.ts"
  node @orders module "orders.ts" {
    signature @getOrder parameters=["id": string] returns=@Result
  }
  wire @i1 @routes -> @orders.@getOrder kind=imports
}
collection @v2-modules "Modules" uses=@modules-model {
  section @s-mod "Imports" mode=modules {
    show @api { show @routes }
    show @core { show @orders }
    connect @i1
  }
}
