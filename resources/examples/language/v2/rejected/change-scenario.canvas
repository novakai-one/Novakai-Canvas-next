canvas 2
declare @d {
  node @user participant "User"
  node @orders module "orders.ts" {
    signature @placeOrder parameters=["lines": string] returns=string
  }
  scenario @place "Place an order" { call @user -> @orders.@placeOrder }
  change @cycle-1 "Rework" { changed @place }
}
collection @v2-neg-change-scenario "Rejected change scenario" uses=@d {
  section @s "Place order" mode=sequence { show @place }
}
