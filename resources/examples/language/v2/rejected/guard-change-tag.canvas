canvas 2
declare @state-model {
  node @draft state "Draft"
  node @placed state "Placed"
  wire @t1 @draft -> @placed kind=transition guard="[NEW]"
}
collection @v2-neg-guard-change-tag "Rejected guard change tag" uses=@state-model {
  section @s-state "Order states" mode=state {
    show @draft @placed
    connect @t1
  }
}
