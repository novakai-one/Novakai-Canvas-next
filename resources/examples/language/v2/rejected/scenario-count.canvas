canvas 2
declare @d {
  node @user participant "User"
  node @orders module "orders.ts" {
    signature @placeOrder parameters=["lines": string] returns=string
    signature @cancelOrder parameters=["id": string] returns=string
  }
  scenario @place "Place an order" {
    call @user -> @orders.@placeOrder
  }
  scenario @cancel "Cancel an order" {
    call @user -> @orders.@cancelOrder
  }
}
collection @v2-neg "Rejected sequence show" uses=@d {
  section @s "Orders" mode=sequence { show @place @cancel }
}
