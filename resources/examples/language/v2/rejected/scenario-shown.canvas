canvas 2
declare @d {
  node @user participant "User"
  node @orders module "orders.ts" {
    signature @placeOrder parameters=["lines": string] returns=string
  }
  scenario @place "Place an order" {
    call @user -> @orders.@placeOrder
  }
}
collection @v2-neg-scenario-shown "Rejected scenario show" uses=@d {
  section @s-mod "Imports" mode=modules { show @orders @place }
}
