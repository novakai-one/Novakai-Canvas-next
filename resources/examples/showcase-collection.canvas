canvas 1
collection @agent-diagram-atlas "ATLAS / Engineering and ideas" theme=paper layout=grid columns=3 direction=right gap=roomy description="24 original DSL diagrams: three examples in each of eight families. Fictional engineering models and educational explanations; all geometry is app-derived." {

  # ER / 1: er-museum-loans.canvas

 node @er-1-artifact entity "Artifact" role=primary size=large {
  field @er-1-id "artifact_id" type="ArtifactId" key=primary
  field @er-1-title "title" type="string"
  field @er-1-period "period" type="Period"
 }
 node @er-1-museum entity "Museum" role=primary size=medium {
  field @er-1-id "museum_id" type="MuseumId" key=primary
  field @er-1-name "name" type="string"
 }
 node @er-1-loan entity "Loan" size=large {
  field @er-1-id "loan_id" type="LoanId" key=primary
  field @er-1-museum "borrower_id" type="MuseumId" key=foreign references=@er-1-museum.@er-1-id
  field @er-1-due "due_date" type="Date"
 }
 node @er-1-loan-item entity "Loan item" role=supporting size=medium {
  field @er-1-loan "loan_id" type="LoanId" key=foreign references=@er-1-loan.@er-1-id
  field @er-1-artifact "artifact_id" type="ArtifactId" key=foreign references=@er-1-artifact.@er-1-id
  keygroup @er-1-identity kind=primary fields=[@er-1-loan,@er-1-artifact]
 }
 node @er-1-inspection entity "Inspection" role=success size=small {
  field @er-1-id "inspection_id" type="InspectionId" key=primary
  field @er-1-artifact "artifact_id" type="ArtifactId" key=foreign references=@er-1-artifact.@er-1-id
  field @er-1-condition "condition" type="Condition"
 }
 wire @er-1-borrows @er-1-museum.@er-1-id -> @er-1-loan.@er-1-museum "borrows" kind=association from=1 to=0..many
 wire @er-1-includes @er-1-loan.@er-1-id -> @er-1-loan-item.@er-1-loan "includes" kind=association from=1 to=1..many
 wire @er-1-travels @er-1-artifact.@er-1-id -> @er-1-loan-item.@er-1-artifact "travels on" kind=association from=1 to=0..many
 wire @er-1-checked @er-1-artifact.@er-1-id -> @er-1-inspection.@er-1-artifact "optionally checked by" kind=association from=1 to=0..many
 section @er-1-museum-loans "MUSEUM LOANS / Trace every movement" mode=er layout=layered direction=right gap=compact order=0 {
  show @er-1-museum @er-1-loan @er-1-artifact @er-1-loan-item @er-1-inspection
  connect @er-1-borrows @er-1-includes @er-1-travels @er-1-checked
 }

  # ER / 2: er-course-enrollment.canvas

 node @er-2-student entity "Student" role=primary size=medium {
  field @er-2-campus "campus_id" type="CampusId"
  field @er-2-number "student_no" type="StudentNo"
  field @er-2-name "display_name" type="string"
  keygroup @er-2-identity kind=primary fields=[@er-2-campus,@er-2-number]
 }
 node @er-2-course entity "Course" role=supporting size=medium {
  field @er-2-school "school_code" type="SchoolCode"
  field @er-2-code "course_code" type="CourseCode"
  field @er-2-title "title" type="string"
  keygroup @er-2-identity kind=primary fields=[@er-2-school,@er-2-code]
 }
 node @er-2-offering entity "Course offering" size=large {
  field @er-2-school "school_code" type="SchoolCode"
  field @er-2-course "course_code" type="CourseCode"
  field @er-2-term "term_code" type="TermCode"
  keygroup @er-2-identity kind=primary fields=[@er-2-school,@er-2-course,@er-2-term]
  keygroup @er-2-course-ref kind=foreign fields=[@er-2-school,@er-2-course] references=[@er-2-course.@er-2-school,@er-2-course.@er-2-code]
 }
 node @er-2-enrollment entity "Enrollment" role=success size=large {
  field @er-2-campus "campus_id" type="CampusId"
  field @er-2-student "student_no" type="StudentNo"
  field @er-2-school "school_code" type="SchoolCode"
  field @er-2-course "course_code" type="CourseCode"
  field @er-2-term "term_code" type="TermCode"
  field @er-2-status "status" type="EnrollmentStatus"
  keygroup @er-2-identity kind=primary fields=[@er-2-campus,@er-2-student,@er-2-school,@er-2-course,@er-2-term]
  keygroup @er-2-student-ref kind=foreign fields=[@er-2-campus,@er-2-student] references=[@er-2-student.@er-2-campus,@er-2-student.@er-2-number]
  keygroup @er-2-offering-ref kind=foreign fields=[@er-2-school,@er-2-course,@er-2-term] references=[@er-2-offering.@er-2-school,@er-2-offering.@er-2-course,@er-2-offering.@er-2-term]
 }
 node @er-2-assessment entity "Assessment result" role=warning size=small {
  field @er-2-id "result_id" type="ResultId" key=primary
  field @er-2-grade "grade" type="Grade" nullable=true
 }
 wire @er-2-offers @er-2-course.@er-2-code -> @er-2-offering.@er-2-course "scheduled as" kind=association from=1 to=0..many
 wire @er-2-student-enrolls @er-2-student.@er-2-number -> @er-2-enrollment.@er-2-student "registers through" kind=association from=1 to=0..many
 wire @er-2-offering-enrolls @er-2-offering.@er-2-term -> @er-2-enrollment.@er-2-term "accepts" kind=association from=1 to=0..many
 wire @er-2-earns @er-2-enrollment -> @er-2-assessment "may earn" kind=association from=1 to=0..1
 section @er-2-enrollment-model "COURSE ENROLLMENT / Composite identities across terms" mode=er layout=layered direction=right gap=compact order=1 {
  show @er-2-student @er-2-course @er-2-offering @er-2-enrollment @er-2-assessment
  connect @er-2-offers @er-2-student-enrolls @er-2-offering-enrolls @er-2-earns
 }

  # ER / 3: er-habitat-survey.canvas

 node @er-3-habitat entity "Habitat" role=primary {
  field @er-3-id "habitat_id" type="HabitatId" key=primary
  field @er-3-parent "parent_id" type="HabitatId" key=foreign nullable=true references=@er-3-habitat.@er-3-id
  field @er-3-code "site_code" type="string" key=unique
  field @er-3-name "name" type="string"
 }
 node @er-3-visit entity "Survey visit" {
  field @er-3-id "visit_id" type="VisitId" key=primary
  field @er-3-habitat "habitat_id" type="HabitatId" key=foreign references=@er-3-habitat.@er-3-id
  field @er-3-date "surveyed_at" type="DateTime"
 }
 node @er-3-observer entity "Observer" role=supporting {
  field @er-3-id "observer_id" type="ObserverId" key=primary
  field @er-3-name "name" type="string"
 }
 node @er-3-species entity "Species" {
  field @er-3-id "species_id" type="SpeciesId" key=primary
  field @er-3-name "scientific_name" type="string" key=unique
 }
 node @er-3-observation entity "Observation" role=success size=large {
  field @er-3-id "observation_id" type="ObservationId" key=primary
  field @er-3-visit "visit_id" type="VisitId" key=foreign references=@er-3-visit.@er-3-id
  field @er-3-observer "observer_id" type="ObserverId" key=foreign references=@er-3-observer.@er-3-id
  field @er-3-species "species_id" type="SpeciesId" key=foreign references=@er-3-species.@er-3-id
  field @er-3-count "count" type="NonNegativeInt"
  field @er-3-confidence "confidence" type="Confidence"
 }
 wire @er-3-nested @er-3-habitat.@er-3-id -> @er-3-habitat.@er-3-parent "contains subhabitats" kind=association from=0..1 to=0..many
 wire @er-3-surveyed @er-3-habitat.@er-3-id -> @er-3-visit.@er-3-habitat "hosts visits" kind=association from=1 to=0..many
 wire @er-3-records @er-3-visit.@er-3-id -> @er-3-observation.@er-3-visit "records sightings" kind=association from=1 to=0..many
 wire @er-3-reports @er-3-observer.@er-3-id -> @er-3-observation.@er-3-observer "reports sightings" kind=association from=1 to=0..many
 wire @er-3-identifies @er-3-species.@er-3-id -> @er-3-observation.@er-3-species "identified in" kind=association from=1 to=0..many
 section @er-3-habitats "HABITAT SURVEY / Nested places, dated evidence" mode=er layout=layered direction=down gap=compact order=2 {
  show @er-3-habitat @er-3-visit @er-3-observer @er-3-species @er-3-observation
  connect @er-3-nested @er-3-surveyed @er-3-records @er-3-reports @er-3-identifies
 }

  # MODULES / 1: modules-document-publishing.canvas

 node @modules-1-editor module "Editorial workspace" role=primary size=large {
  port @modules-1-drafts out "drafts" type="DraftRepository"
  port @modules-1-publish out "publisher" type="PublicationPort"
 }
 node @modules-1-publication interface "PublicationPort" role=supporting size=medium {
  member @modules-1-submit "submit" type="(ApprovedDraft) => Promise<PublicationReceipt>" visibility=public
  member @modules-1-withdraw "withdraw" type="(PublicationId, Reason) => Promise<WithdrawalReceipt>" visibility=public
 }
 node @modules-1-validate function "validateApproval" size=medium {
  signature @modules-1-call "validateApproval" parameters=["draft: Draft", "policy: EditorialPolicy"] returns="Result<ApprovedDraft, ValidationError>"
 }
 node @modules-1-web-adapter module "Web publisher adapter" role=success size=large {
  port @modules-1-input in "approved draft" type="ApprovedDraft"
  port @modules-1-remote out "CMS client" type="CmsClient"
 }
 node @modules-1-cms interface "External CMS" role=warning size=small {
  member @modules-1-create "createPage" type="(CmsPage) => Promise<CmsPageId>" visibility=public
 }
 wire @modules-1-checks @modules-1-editor.@modules-1-drafts -> @modules-1-validate "validates approval with" kind=calls
 wire @modules-1-imports @modules-1-editor.@modules-1-publish -> @modules-1-publication "depends on publishing contract" kind=imports
 wire @modules-1-implements @modules-1-web-adapter.@modules-1-input -> @modules-1-publication.@modules-1-submit "implements submit" kind=implements
 wire @modules-1-calls-cms @modules-1-web-adapter.@modules-1-remote -> @modules-1-cms "imports the external CMS contract" kind=imports
 section @modules-1-publishing-boundary "PUBLISHING / Policy inside, vendor outside" mode=modules layout=layered direction=right gap=compact order=3 {
  show @modules-1-editor @modules-1-validate @modules-1-publication @modules-1-web-adapter @modules-1-cms
  connect @modules-1-checks @modules-1-imports @modules-1-implements @modules-1-calls-cms
 }

  # MODULES / 2: modules-sensor-gateway.canvas

 node @modules-2-gateway module "Sensor gateway" role=primary size=large {
  port @modules-2-readings in "readings" type="AsyncIterable<RawReading>"
  port @modules-2-normalizer out "normalizer" type="ReadingNormalizer"
  port @modules-2-events out "events" type="TelemetrySink"
 }
 node @modules-2-normalizer interface "ReadingNormalizer" role=supporting size=medium {
  member @modules-2-normalize "normalize" type="(RawReading, Calibration) => Result<Measurement, ReadingError>" visibility=public
 }
 node @modules-2-normalize function "normalizeReading" size=large {
  signature @modules-2-call "normalizeReading" parameters=["reading: RawReading", "calibration: Calibration", "clock: Clock"] returns="Result<Measurement, ReadingError>"
 }
 node @modules-2-mqtt module "MQTT input adapter" size=medium {
  port @modules-2-packets in "packets" type="MqttPacket"
  port @modules-2-decoded out "decoded readings" type="AsyncIterable<RawReading>"
 }
 node @modules-2-serial module "Serial input adapter" size=medium {
  port @modules-2-frames in "frames" type="SerialFrame"
  port @modules-2-decoded out "decoded readings" type="AsyncIterable<RawReading>"
 }
 node @modules-2-sink interface "TelemetrySink" role=success size=small {
  member @modules-2-append "append" type="(Measurement) => Promise<Ack>" visibility=public
 }
 wire @modules-2-mqtt-feeds @modules-2-mqtt.@modules-2-decoded -> @modules-2-gateway.@modules-2-readings "streams decoded MQTT readings" kind=reference
 wire @modules-2-serial-feeds @modules-2-serial.@modules-2-decoded -> @modules-2-gateway.@modules-2-readings "streams decoded serial readings" kind=reference
 wire @modules-2-uses-normalizer @modules-2-gateway.@modules-2-normalizer -> @modules-2-normalizer "imports normalization contract" kind=imports
 wire @modules-2-implements-normalizer @modules-2-normalize -> @modules-2-normalizer.@modules-2-normalize "implements normalize" kind=implements
 wire @modules-2-emits @modules-2-gateway.@modules-2-events -> @modules-2-sink "imports telemetry sink contract" kind=imports
 section @modules-2-gateway-boundary "SENSOR GATEWAY / Two transports, one typed core" mode=modules layout=layered direction=right gap=compact order=4 {
  show @modules-2-mqtt @modules-2-serial @modules-2-gateway @modules-2-normalizer @modules-2-normalize @modules-2-sink
  connect @modules-2-mqtt-feeds @modules-2-serial-feeds @modules-2-uses-normalizer @modules-2-implements-normalizer @modules-2-emits
 }

  # MODULES / 3: modules-payroll-policy.canvas

 node @modules-3-run module "Payroll run" role=primary {
  port @modules-3-policy out "policy" type="PayPolicy"
  port @modules-3-rounding out "rounding" type="RoundingPolicy"
  port @modules-3-calculate out "calculate" type="PayCalculator"
 }
 node @modules-3-policy interface "PayPolicy" role=supporting {
  member @modules-3-gross "gross" type="(WorkPeriod, Rate) => Money" visibility=public
  member @modules-3-deduct "deductions" type="(Money, TaxProfile) => Money" visibility=public
 }
 node @modules-3-rounding interface "RoundingPolicy" {
  member @modules-3-round "round" type="(Money, Currency) => Money" visibility=public
 }
 node @modules-3-calculate function "calculatePay" size=large {
  signature @modules-3-call "calculatePay" parameters=["period: WorkPeriod", "policy: PayPolicy", "rounding: RoundingPolicy"] returns="PayStatement"
 }
 node @modules-3-gross function "grossPay" {
  signature @modules-3-call "grossPay" parameters=["period: WorkPeriod", "rate: Rate"] returns="Money"
 }
 node @modules-3-deduct function "deductions" {
  signature @modules-3-call "deductions" parameters=["gross: Money", "profile: TaxProfile"] returns="Money"
 }
 node @modules-3-round function "roundMoney" {
  signature @modules-3-call "roundMoney" parameters=["value: Money", "currency: Currency"] returns="Money"
 }
 wire @modules-3-imports-policy @modules-3-run.@modules-3-policy -> @modules-3-policy "imports pay rules" kind=imports
 wire @modules-3-imports-rounding @modules-3-run.@modules-3-rounding -> @modules-3-rounding "imports rounding rules" kind=imports
 wire @modules-3-imports-calculator @modules-3-run.@modules-3-calculate -> @modules-3-calculate "imports calculator" kind=imports
 wire @modules-3-call-gross @modules-3-calculate -> @modules-3-gross "calculates gross" kind=calls
 wire @modules-3-call-deduct @modules-3-calculate -> @modules-3-deduct "calculates deductions" kind=calls
 wire @modules-3-call-round @modules-3-calculate -> @modules-3-round "rounds net amount" kind=calls
 wire @modules-3-gross-policy @modules-3-gross -> @modules-3-policy.@modules-3-gross "implements gross" kind=implements
 wire @modules-3-deduct-policy @modules-3-deduct -> @modules-3-policy.@modules-3-deduct "implements deductions" kind=implements
 wire @modules-3-round-policy @modules-3-round -> @modules-3-rounding.@modules-3-round "implements round" kind=implements
 section @modules-3-payroll "PAYROLL / Callable rules behind two contracts" mode=modules layout=layered direction=down gap=compact order=5 {
  group @modules-3-contracts "RULE CONTRACTS" { show @modules-3-policy @modules-3-rounding }
  group @modules-3-functions "PURE CALCULATION" { show @modules-3-calculate @modules-3-gross @modules-3-deduct @modules-3-round }
  show @modules-3-run
  connect @modules-3-imports-policy @modules-3-imports-rounding @modules-3-imports-calculator @modules-3-call-gross @modules-3-call-deduct @modules-3-call-round @modules-3-gross-policy @modules-3-deduct-policy @modules-3-round-policy
 }

  # FLOW / 1: flow-equipment-return.canvas

 node @flow-1-receive step "1 · Receive" role=primary { text @flow-1-detail "Record the item and its borrower." }
 node @flow-1-inspect decision "Safe to reuse?" { text @flow-1-detail "Inspect before closing the loan." }
 node @flow-1-service step "Repair" role=warning { text @flow-1-detail "Quarantine and record the defect." }
 node @flow-1-clean step "2 · Clean" { text @flow-1-detail "Prepare the kit for its next user." }
 node @flow-1-restock step "3 · Restock" role=success { text @flow-1-detail "Return all parts to the assigned shelf." }
 node @flow-1-receipt end "Loan closed" role=success {}
 wire @flow-1-check @flow-1-receive -> @flow-1-inspect "inspect" kind=flow
 wire @flow-1-fail @flow-1-inspect -> @flow-1-service "no" kind=flow
 wire @flow-1-retry @flow-1-service -> @flow-1-inspect "recheck" kind=flow
 wire @flow-1-pass @flow-1-inspect -> @flow-1-clean "yes" kind=flow
 wire @flow-1-ready @flow-1-clean -> @flow-1-restock "dry and complete" kind=flow
 wire @flow-1-close @flow-1-restock -> @flow-1-receipt "issue receipt" kind=flow
 section @flow-1-equipment-return "RETURN / Inspect before restocking" mode=flow direction=right gap=compact order=6 {
  show @flow-1-receive @flow-1-inspect @flow-1-service @flow-1-clean @flow-1-restock @flow-1-receipt
  connect @flow-1-check @flow-1-fail @flow-1-pass @flow-1-ready @flow-1-close
  connect @flow-1-retry source-side=bottom target-side=bottom
 }

  # FLOW / 2: flow-research-approval.canvas

 node @flow-2-submit start "Protocol submitted" role=primary size=small {}
 node @flow-2-triage step "Administrative triage" size=medium { text @flow-2-detail "Confirm ownership, version and required documents." }
 node @flow-2-split fork "Parallel review" role=supporting size=small {}
 node @flow-2-ethics step "Ethics review" size=large { text @flow-2-detail "Assess consent, risk and participant safeguards." }
 node @flow-2-methods step "Methods review" size=large { text @flow-2-detail "Assess design, sample and analysis plan." }
 node @flow-2-merge join "Reviews complete" role=supporting size=small {}
 node @flow-2-decision decision "Both reviews approve?" role=decision size=medium {}
 node @flow-2-revise step "Revise protocol" role=warning size=medium { text @flow-2-detail "Resolve the consolidated requests before resubmission." }
 node @flow-2-approved end "Approval recorded" role=success size=small {}
 wire @flow-2-begin @flow-2-submit -> @flow-2-triage "open case" kind=flow
 wire @flow-2-ready @flow-2-triage -> @flow-2-split "documents complete" kind=flow
 wire @flow-2-ethics-path @flow-2-split -> @flow-2-ethics "review safeguards" kind=flow
 wire @flow-2-methods-path @flow-2-split -> @flow-2-methods "review evidence plan" kind=flow
 wire @flow-2-ethics-done @flow-2-ethics -> @flow-2-merge "ethics recommendation" kind=flow
 wire @flow-2-methods-done @flow-2-methods -> @flow-2-merge "methods recommendation" kind=flow
 wire @flow-2-decide @flow-2-merge -> @flow-2-decision "combine findings" kind=flow
 wire @flow-2-accept @flow-2-decision -> @flow-2-approved "yes" kind=flow
 wire @flow-2-changes @flow-2-decision -> @flow-2-revise "no · changes required" kind=flow
 wire @flow-2-resubmit @flow-2-revise -> @flow-2-triage "resubmit new version" kind=flow style=dashed
 section @flow-2-approval "RESEARCH APPROVAL / Independent review, one decision" mode=flow direction=right gap=compact order=7 {
  show @flow-2-submit @flow-2-triage @flow-2-split @flow-2-ethics @flow-2-methods @flow-2-merge @flow-2-decision @flow-2-revise @flow-2-approved
  connect @flow-2-begin @flow-2-ready @flow-2-ethics-path @flow-2-methods-path @flow-2-ethics-done @flow-2-methods-done @flow-2-decide @flow-2-accept @flow-2-changes
  connect @flow-2-resubmit source-side=bottom target-side=bottom
 }

  # FLOW / 3: flow-emergency-dispatch.canvas

 node @flow-3-reported start "Incident reported" role=primary {}
 node @flow-3-assess step "Classify incident" { text @flow-3-detail "Record location, incident type and contact." }
 node @flow-3-eligible decision "Dispatch required?" role=decision {}
 node @flow-3-referred end "Referral recorded" role=supporting {}
 node @flow-3-available decision "Unit available?" role=decision {}
 node @flow-3-escalate step "Escalate to supervisor" role=warning { text @flow-3-detail "Request mutual aid and record the unmet need." }
 node @flow-3-aid decision "Aid confirmed?" role=decision {}
 node @flow-3-assign step "Assign responding unit" { text @flow-3-detail "Send incident details and await acceptance." }
 node @flow-3-accepted end "Response assigned" role=success {}
 node @flow-3-unresolved end "Unresolved escalation" role=warning { text @flow-3-detail "Keep the incident open in the supervisor queue." }
 wire @flow-3-open @flow-3-reported -> @flow-3-assess "open incident" kind=flow
 wire @flow-3-classify @flow-3-assess -> @flow-3-eligible "classification ready" kind=flow
 wire @flow-3-refer @flow-3-eligible -> @flow-3-referred "no: refer service" kind=flow
 wire @flow-3-needed @flow-3-eligible -> @flow-3-available "yes: seek unit" kind=flow
 wire @flow-3-local @flow-3-available -> @flow-3-assign "yes: local unit" kind=flow
 wire @flow-3-shortage @flow-3-available -> @flow-3-escalate "no: resource gap" kind=flow
 wire @flow-3-request @flow-3-escalate -> @flow-3-aid "check mutual aid" kind=flow
 wire @flow-3-mutual @flow-3-aid -> @flow-3-assign "yes: aid unit" kind=flow
 wire @flow-3-pending @flow-3-aid -> @flow-3-unresolved "no: retain ownership" kind=flow
 wire @flow-3-dispatch @flow-3-assign -> @flow-3-accepted "unit accepts" kind=flow
 section @flow-3-dispatch "DISPATCH / Escalation preserves incident ownership" mode=flow direction=down gap=compact order=8 {
  show @flow-3-reported @flow-3-assess @flow-3-eligible @flow-3-referred @flow-3-available @flow-3-escalate @flow-3-aid @flow-3-assign @flow-3-accepted @flow-3-unresolved
  connect @flow-3-open @flow-3-classify @flow-3-refer @flow-3-needed @flow-3-local @flow-3-shortage @flow-3-request @flow-3-mutual @flow-3-pending @flow-3-dispatch
 }

  # SEQUENCE / 1: sequence-library-reservation.canvas

 node @sequence-1-reader participant "Reader" role=primary size=medium {}
 node @sequence-1-catalog participant "Catalog" size=medium {}
 node @sequence-1-holds participant "Reservations" role=supporting size=large {}
 node @sequence-1-notice participant "Notifications" size=small {}
 node @sequence-1-desk participant "Pickup desk" role=success size=medium {}
 section @sequence-1-library-reservation "RESERVATION / Availability decides the path" mode=sequence direction=down gap=compact order=9 {
  show @sequence-1-reader @sequence-1-catalog @sequence-1-holds @sequence-1-notice @sequence-1-desk
  event @sequence-1-search @sequence-1-reader -> @sequence-1-catalog "Find a copy" kind=call activate=true
  event @sequence-1-status @sequence-1-catalog -> @sequence-1-reader "Return availability" kind=return activate=false
  fragment @sequence-1-availability alt "Reserve or wait" {
   branch @sequence-1-available "Copy available" {
    event @sequence-1-hold @sequence-1-reader -> @sequence-1-holds "Reserve copy" kind=call activate=true
    event @sequence-1-notify @sequence-1-holds -> @sequence-1-notice "Send confirmation" kind=async
    event @sequence-1-stage @sequence-1-holds -> @sequence-1-desk "Prepare pickup" kind=async
    event @sequence-1-confirmed @sequence-1-holds -> @sequence-1-reader "Return reservation receipt" kind=return activate=false
   }
   branch @sequence-1-unavailable "No copy available" {
    event @sequence-1-queue @sequence-1-reader -> @sequence-1-holds "Join waitlist" kind=call
    event @sequence-1-queued @sequence-1-holds -> @sequence-1-reader "Return queue position" kind=return
   }
  }
 }

  # SEQUENCE / 2: sequence-payment-settlement.canvas

 node @sequence-2-merchant participant "Merchant" role=primary size=medium {}
 node @sequence-2-payments participant "Payment service" role=supporting size=large {}
 node @sequence-2-ledger participant "Ledger" size=medium {}
 node @sequence-2-network participant "Bank network" role=warning size=large {}
 node @sequence-2-webhook participant "Merchant webhook" role=success size=small {}
 section @sequence-2-settlement "SETTLEMENT / Retry submission, confirm asynchronously" mode=sequence direction=down gap=compact order=10 {
  show @sequence-2-merchant @sequence-2-payments @sequence-2-ledger @sequence-2-network @sequence-2-webhook
  event @sequence-2-capture @sequence-2-merchant -> @sequence-2-payments "Capture authorized payment" kind=call activate=true
  event @sequence-2-pending @sequence-2-payments -> @sequence-2-ledger "Record pending settlement" kind=call
  fragment @sequence-2-attempts loop "Until accepted or retry limit" {
   event @sequence-2-submit @sequence-2-payments -> @sequence-2-network "Submit settlement batch" kind=call activate=true
   event @sequence-2-ack @sequence-2-network -> @sequence-2-payments "Return batch acceptance" kind=return activate=false
  }
  event @sequence-2-accepted @sequence-2-payments -> @sequence-2-merchant "Return accepted receipt" kind=return activate=false
  event @sequence-2-callback @sequence-2-network -> @sequence-2-payments "Settlement completed callback" kind=async activate=true
  event @sequence-2-post @sequence-2-payments -> @sequence-2-ledger "Post final settlement" kind=call
  event @sequence-2-notify @sequence-2-payments -> @sequence-2-webhook "Publish settlement outcome" kind=async activate=false
 }

  # SEQUENCE / 3: sequence-incident-notification.canvas

 node @sequence-3-monitor participant "Monitor" role=primary {}
 node @sequence-3-incident participant "Incident service" role=supporting {}
 node @sequence-3-directory participant "On-call directory" {}
 node @sequence-3-pager participant "Pager" role=warning {}
 node @sequence-3-responder participant "Responder" role=success {}
 section @sequence-3-notification "NOTIFICATION / Deduplicate, optionally page, acknowledge" mode=sequence direction=down gap=compact order=11 {
  show @sequence-3-monitor @sequence-3-incident @sequence-3-directory @sequence-3-pager @sequence-3-responder
  event @sequence-3-report @sequence-3-monitor -> @sequence-3-incident "Report alert fingerprint" kind=call activate=true
  event @sequence-3-dedupe @sequence-3-incident -> @sequence-3-incident "Check deduplication window" kind=call
  fragment @sequence-3-page opt "New actionable incident" {
   event @sequence-3-lookup @sequence-3-incident -> @sequence-3-directory "Resolve current on-call" kind=call activate=true
   event @sequence-3-contact @sequence-3-directory -> @sequence-3-incident "Return contact route" kind=return activate=false
   event @sequence-3-send @sequence-3-incident -> @sequence-3-pager "Queue incident page" kind=call activate=true
   event @sequence-3-queued @sequence-3-pager -> @sequence-3-incident "Return delivery receipt" kind=return activate=false
   event @sequence-3-deliver @sequence-3-pager -> @sequence-3-responder "Deliver incident page" kind=async
  }
  event @sequence-3-receipt @sequence-3-incident -> @sequence-3-monitor "Return incident identity" kind=return activate=false
  fragment @sequence-3-acknowledge opt "Responder accepts ownership" {
   event @sequence-3-ack @sequence-3-responder -> @sequence-3-incident "Acknowledge incident" kind=call activate=true
   event @sequence-3-record @sequence-3-incident -> @sequence-3-incident "Record owner and timestamp" kind=call
   event @sequence-3-confirmed @sequence-3-incident -> @sequence-3-responder "Confirm ownership" kind=return activate=false
  }
 }

  # STATE / 1: state-exhibition-lifecycle.canvas

 node @state-1-start start "Begin" size=small {}
 node @state-1-draft state "Draft" role=primary size=medium { text @state-1-detail "Objects and interpretation are still changing." }
 node @state-1-review state "Under review" role=supporting size=large { text @state-1-detail "Curatorial and rights checks run together." }
 node @state-1-published state "Published" role=success size=medium { text @state-1-detail "The approved exhibition is visible." }
 node @state-1-rollback state "Rollback pending" role=warning size=large { text @state-1-detail "Restore the last approved release and preserve evidence." }
 node @state-1-withdrawn state "Withdrawn" role=warning size=medium { text @state-1-detail "Public access is disabled with a recorded reason." }
 node @state-1-end end "Closed" size=small {}
 wire @state-1-prepare @state-1-start -> @state-1-draft "create draft" kind=transition effect="open working version"
 wire @state-1-submit @state-1-draft -> @state-1-review "submit for review" kind=transition guard="required material complete"
 wire @state-1-revise @state-1-review -> @state-1-draft "request revision" kind=transition guard="changes requested" effect="record findings"
 wire @state-1-publish @state-1-review -> @state-1-published "publish approved release" kind=transition guard="curator and rights approved" effect="pin release"
 wire @state-1-detect @state-1-published -> @state-1-rollback "begin rollback" kind=transition guard="material defect found" effect="freeze affected release"
 wire @state-1-restore @state-1-rollback -> @state-1-published "restore prior release" kind=transition guard="safe release available" effect="record rollback receipt"
 wire @state-1-withdraw @state-1-rollback -> @state-1-withdrawn "withdraw exhibition" kind=transition guard="no safe release" effect="post public notice"
 wire @state-1-close @state-1-withdrawn -> @state-1-end "close record" kind=transition guard="retention captured"
 section @state-1-lifecycle "EXHIBITION / Guard publication and recover safely" mode=state layout=layered direction=right gap=compact order=12 {
  show @state-1-start @state-1-draft @state-1-review @state-1-published @state-1-rollback @state-1-withdrawn @state-1-end
  connect @state-1-prepare @state-1-submit @state-1-revise @state-1-publish @state-1-detect @state-1-restore @state-1-withdraw @state-1-close
 }

  # STATE / 2: state-batch-job.canvas

 node @state-2-start start "Queued" size=small {}
 node @state-2-running state "Running" role=primary size=large { text @state-2-detail "Process the claimed batch under one attempt." }
 node @state-2-backoff state "Waiting to retry" role=warning size=medium { text @state-2-detail "Keep the failure and schedule the next attempt." }
 node @state-2-cancelling state "Cancelling" role=supporting size=medium { text @state-2-detail "Stop new work and release held resources." }
 node @state-2-failed state "Failed" role=warning size=medium { text @state-2-detail "Retry budget is exhausted." }
 node @state-2-succeeded state "Succeeded" role=success size=medium { text @state-2-detail "Outputs and completion receipt are durable." }
 node @state-2-end end "Terminal" size=small {}
 wire @state-2-claim @state-2-start -> @state-2-running "claim batch" kind=transition guard="worker available" effect="increment attempt"
 wire @state-2-retry @state-2-running -> @state-2-backoff "schedule retry" kind=transition guard="transient failure and attempts remain" effect="record error"
 wire @state-2-resume @state-2-backoff -> @state-2-running "retry batch" kind=transition guard="backoff elapsed" effect="increment attempt"
 wire @state-2-exhaust @state-2-running -> @state-2-failed "mark failed" kind=transition guard="retry budget exhausted" effect="retain diagnostics"
 wire @state-2-complete @state-2-running -> @state-2-succeeded "commit outputs" kind=transition guard="all items processed" effect="write receipt"
 wire @state-2-cancel-running @state-2-running -> @state-2-cancelling "request cancel" kind=transition guard="operator requested"
 wire @state-2-cancel-wait @state-2-backoff -> @state-2-cancelling "cancel scheduled retry" kind=transition guard="operator requested"
 wire @state-2-cancelled @state-2-cancelling -> @state-2-end "confirm cancelled" kind=transition guard="resources released" effect="write cancellation receipt"
 wire @state-2-finish-failed @state-2-failed -> @state-2-end "close failed job" kind=transition effect="publish outcome"
 wire @state-2-finish-success @state-2-succeeded -> @state-2-end "close successful job" kind=transition effect="publish outcome"
 section @state-2-job "BATCH JOB / Retry transient faults, cancel cleanly" mode=state layout=layered direction=right gap=compact order=13 {
  show @state-2-start @state-2-running @state-2-backoff @state-2-cancelling @state-2-failed @state-2-succeeded @state-2-end
  connect @state-2-claim @state-2-retry @state-2-resume @state-2-exhaust @state-2-complete @state-2-cancel-running @state-2-cancel-wait @state-2-cancelled @state-2-finish-failed @state-2-finish-success
 }

  # STATE / 3: state-membership-reinstatement.canvas

 node @state-3-start start "Application" {}
 node @state-3-pending state "Pending approval" role=supporting {}
 node @state-3-active state "Active" role=success { text @state-3-detail "Member privileges are enabled." }
 node @state-3-suspended state "Suspended" role=warning { text @state-3-detail "Privileges paused; history retained." }
 node @state-3-review state "Reinstatement review" role=primary { text @state-3-detail "Verify the remedy and reviewer decision." }
 node @state-3-restored state "Reinstated" role=success { text @state-3-detail "Access restored with a monitored review period." }
 node @state-3-closed end "Closed" {}
 wire @state-3-submit @state-3-start -> @state-3-pending "submit application" kind=transition effect="record applicant"
 wire @state-3-approve @state-3-pending -> @state-3-active "approve" kind=transition guard="eligibility confirmed" effect="enable privileges"
 wire @state-3-decline @state-3-pending -> @state-3-closed "decline" kind=transition guard="ineligible" effect="retain decision"
 wire @state-3-suspend @state-3-active -> @state-3-suspended "suspend" kind=transition guard="policy breach upheld" effect="pause privileges"
 wire @state-3-appeal @state-3-suspended -> @state-3-review "request reinstatement" kind=transition guard="remedy submitted"
 wire @state-3-reject @state-3-review -> @state-3-suspended "request more evidence" kind=transition guard="remedy incomplete"
 wire @state-3-restore @state-3-review -> @state-3-restored "approve reinstatement" kind=transition guard="remedy verified" effect="restore privileges"
 wire @state-3-complete @state-3-restored -> @state-3-active "complete review period" kind=transition guard="conditions met"
 wire @state-3-relapse @state-3-restored -> @state-3-suspended "suspend again" kind=transition guard="conditions breached"
 wire @state-3-withdraw @state-3-suspended -> @state-3-closed "withdraw membership" kind=transition guard="member requests closure"
 section @state-3-membership "MEMBERSHIP / Reinstatement is a reviewed return" mode=state layout=layered direction=right gap=compact order=14 {
  show @state-3-start @state-3-pending @state-3-active @state-3-suspended @state-3-review @state-3-restored @state-3-closed
  connect @state-3-submit @state-3-approve @state-3-decline @state-3-suspend @state-3-appeal @state-3-reject @state-3-restore @state-3-complete @state-3-relapse @state-3-withdraw
 }

