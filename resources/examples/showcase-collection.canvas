 section @grid-1-archive-comparison "ARCHIVE OPTIONS / Choose by the failure you can tolerate" mode=grid layout=grid columns=2 gap=compact order=21 {
  group @grid-1-options "Three operating models" layout=grid columns=3 gap=compact {
   group @grid-1-local "LOCAL" represents=@grid-1-local-policy layout=grid columns=1 gap=compact { show @grid-1-local-speed @grid-1-local-risk }
   group @grid-1-shared "SHARED" represents=@grid-1-shared-policy layout=grid columns=1 gap=compact { show @grid-1-shared-access @grid-1-shared-risk }
   group @grid-1-hybrid "HYBRID" represents=@grid-1-hybrid-policy layout=grid columns=1 gap=compact { show @grid-1-hybrid-access @grid-1-hybrid-risk }
  }
 }

  # GRID / 2: grid-feedback-methods.canvas

 asset @grid-2-evidence image source="./showcase/assets/evidence.svg" alt="A document with a magnifying lens"
 asset @grid-2-lesson image source="./showcase/assets/lesson.svg" alt="An open lesson book"
 asset @grid-2-reed image source="./showcase/assets/reed.svg" alt="A reed suggesting an in-context observation"
 asset @grid-2-water image source="./showcase/assets/water.svg" alt="A water drop suggesting a measured signal"
 node @grid-2-interview concept "Interview" role=primary size=large { icon @grid-2-symbol asset=@grid-2-lesson size=medium text @grid-2-detail "Ask why a recent moment mattered." }
 node @grid-2-interview-use note "Rich explanation · low scale" size=small { text @grid-2-tip "Use after a specific experience, not for predictions." }
 node @grid-2-survey concept "Survey" role=supporting size=large { icon @grid-2-symbol asset=@grid-2-evidence size=medium text @grid-2-detail "Measure a known question across many people." }
 node @grid-2-survey-use note "Broad pattern · fixed questions" size=small { text @grid-2-tip "Pilot wording before comparing responses." }
 node @grid-2-observation concept "Observation" role=success size=large { icon @grid-2-symbol asset=@grid-2-reed size=medium text @grid-2-detail "Watch real work in its normal setting." }
 node @grid-2-observation-use note "Real behavior · slower analysis" size=small { text @grid-2-tip "Record context as well as actions." }
 node @grid-2-telemetry concept "Telemetry" role=warning size=large { icon @grid-2-symbol asset=@grid-2-water size=medium text @grid-2-detail "Track what happened at product scale." }
 node @grid-2-telemetry-use note "Continuous signal · weak intent" size=small { text @grid-2-tip "Pair behavior with a method that explains why." }
 section @grid-2-feedback-grid "FEEDBACK METHODS / Match the method to the question" mode=grid layout=grid columns=2 gap=compact order=22 {
  group @grid-2-explain "EXPLAIN" represents=@grid-2-interview layout=grid columns=1 gap=compact { show @grid-2-interview-use }
  group @grid-2-measure "MEASURE" represents=@grid-2-survey layout=grid columns=1 gap=compact { show @grid-2-survey-use }
  group @grid-2-observe "OBSERVE" represents=@grid-2-observation layout=grid columns=1 gap=compact { show @grid-2-observation-use }
  group @grid-2-monitor "MONITOR" represents=@grid-2-telemetry layout=grid columns=1 gap=compact { show @grid-2-telemetry-use }
 }

  # GRID / 3: grid-research-methods.canvas

 node @grid-3-question concept "Start with the claim" role=primary { text @grid-3-detail "Choose evidence that can challenge the claim." }
 node @grid-3-experiment concept "Experiment" role=success {
  table @grid-3-matrix columns=["Dimension", "Evidence"] {
   row @grid-3-question cells=["Question", "Did a change affect an outcome?"]
   row @grid-3-record cells=["Record", "Assigned groups and outcomes"]
   row @grid-3-limit cells=["Limit", "Setting may constrain transfer"]
  }
 }
 node @grid-3-cohort concept "Cohort study" role=supporting {
  table @grid-3-matrix columns=["Dimension", "Evidence"] {
   row @grid-3-question cells=["Question", "What changes over time?"]
   row @grid-3-record cells=["Record", "Repeated observations"]
   row @grid-3-limit cells=["Limit", "Confounding and attrition"]
  }
 }
 node @grid-3-case concept "Case study" {
  table @grid-3-matrix columns=["Dimension", "Evidence"] {
   row @grid-3-question cells=["Question", "How did this case unfold?"]
   row @grid-3-record cells=["Record", "Documents and accounts"]
   row @grid-3-limit cells=["Limit", "Case selection shapes scope"]
  }
 }
 node @grid-3-synthesis concept "Evidence synthesis" {
  table @grid-3-matrix columns=["Dimension", "Evidence"] {
   row @grid-3-question cells=["Question", "What do studies agree on?"]
   row @grid-3-record cells=["Record", "Included studies and quality"]
   row @grid-3-limit cells=["Limit", "Missing or uneven studies"]
  }
 }
 node @grid-3-causal note "Before a causal claim" role=warning { list @grid-3-checks ["Check the comparison", "Check assignment and missing data"] }
 node @grid-3-triangulate note "Combine complementary evidence" { text @grid-3-detail "Use case context to interpret patterns; test explanations with new comparisons." }
 section @grid-3-methods "RESEARCH METHODS / Compare questions, records and limits" mode=grid layout=grid columns=1 gap=compact order=23 {
  group @grid-3-primary "COLLECT PRIMARY EVIDENCE" layout=grid columns=3 gap=compact {
   show @grid-3-experiment @grid-3-cohort @grid-3-case
  }
  group @grid-3-secondary "REUSE AND CHALLENGE" layout=grid columns=4 gap=compact {
   show @grid-3-synthesis @grid-3-causal @grid-3-question @grid-3-triangulate
  }
 }
}
