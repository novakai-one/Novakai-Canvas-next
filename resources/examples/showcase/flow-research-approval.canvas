canvas 1
collection @flow-research-approval "Research approval workflow" theme=paper {
 node @submit start "Protocol submitted" role=primary size=small {}
 node @triage step "Administrative triage" size=medium { text @detail "Confirm ownership, version and required documents." }
 node @split fork "Parallel review" role=supporting size=small {}
 node @ethics step "Ethics review" size=large { text @detail "Assess consent, risk and participant safeguards." }
 node @methods step "Methods review" size=large { text @detail "Assess design, sample and analysis plan." }
 node @merge join "Reviews complete" role=supporting size=small {}
 node @decision decision "Both reviews approve?" role=decision size=medium {}
 node @revise step "Revise protocol" role=warning size=medium { text @detail "Resolve the consolidated requests before resubmission." }
 node @approved end "Approval recorded" role=success size=small {}
 wire @begin @submit -> @triage "open case" kind=flow
 wire @ready @triage -> @split "documents complete" kind=flow
 wire @ethics-path @split -> @ethics "review safeguards" kind=flow
 wire @methods-path @split -> @methods "review evidence plan" kind=flow
 wire @ethics-done @ethics -> @merge "ethics recommendation" kind=flow
 wire @methods-done @methods -> @merge "methods recommendation" kind=flow
 wire @decide @merge -> @decision "combine findings" kind=flow
 wire @accept @decision -> @approved "yes" kind=flow
 wire @changes @decision -> @revise "no · changes required" kind=flow
 wire @resubmit @revise -> @triage "resubmit new version" kind=flow style=dashed
 section @approval "RESEARCH APPROVAL / Independent review, one decision" mode=flow direction=right gap=compact {
  show @submit @triage @split @ethics @methods @merge @decision @revise @approved
  connect @begin @ready @ethics-path @methods-path @ethics-done @methods-done @decide @accept @changes
  connect @resubmit source-side=bottom target-side=bottom
 }
}
