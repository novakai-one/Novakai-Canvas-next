canvas 1
collection @grid-archive-comparison "Archive operating models" theme=atlas {
 node @local-policy concept "Local archive" role=primary size=large { text @purpose "Keep the original close to the curator." }
 node @local-speed concept "Fast to inspect" size=medium { list @points ["No network dependency", "Immediate full-resolution access"] }
 node @local-risk note "One building is one failure domain" role=warning size=small { text @risk "Arrange an independent backup." }
 node @shared-policy concept "Shared repository" role=supporting size=large { text @purpose "Give partner museums one catalog." }
 node @shared-access concept "Easy to collaborate" size=medium { list @points ["Shared identifiers", "Consistent access policy"] }
 node @shared-risk note "Availability depends on the service" role=warning size=small { text @risk "Keep an offline inventory." }
 node @hybrid-policy concept "Hybrid archive" role=success size=large { text @purpose "Combine local originals and shared discovery." }
 node @hybrid-access concept "Resilient discovery" size=medium { list @points ["Local preservation copy", "Shared searchable metadata"] }
 node @hybrid-risk note "Synchronization needs ownership" role=warning size=small { text @risk "Name the authoritative record." }
 section @archive-comparison "ARCHIVE OPTIONS / Choose by the failure you can tolerate" mode=grid layout=grid columns=2 gap=compact {
  group @options "Three operating models" layout=grid columns=3 gap=compact {
   group @local "LOCAL" represents=@local-policy layout=grid columns=1 gap=compact { show @local-speed @local-risk }
   group @shared "SHARED" represents=@shared-policy layout=grid columns=1 gap=compact { show @shared-access @shared-risk }
   group @hybrid "HYBRID" represents=@hybrid-policy layout=grid columns=1 gap=compact { show @hybrid-access @hybrid-risk }
  }
 }
}
