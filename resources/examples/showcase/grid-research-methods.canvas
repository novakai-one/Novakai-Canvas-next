canvas 1
collection @grid-research-methods "Research methods evidence matrix" theme=studio description="Illustrative method selection aid; evidence strength depends on execution." {
 asset @evidence image source="./assets/evidence.svg" alt="Recorded research evidence"
 node @question concept "Start with the claim" role=primary frame=none composition=media-left { icon @figure asset=@evidence size=small text @detail "Choose evidence that can challenge the claim." }
 node @experiment concept "Experiment" role=success frame=card composition=media-top {
  icon @figure asset=@evidence size=small
  text @caption "Compare outcomes under an assigned change; record the comparison before interpreting the result." role=caption
  table @matrix columns=["Dimension", "Evidence"] {
   row @question cells=["Question", "Did a change affect an outcome?"]
   row @record cells=["Record", "Assigned groups and outcomes"]
   row @limit cells=["Limit", "Setting may constrain transfer"]
  }
 }
 node @cohort concept "Cohort study" role=supporting frame=none composition=media-top {
  icon @figure asset=@evidence size=small
  text @caption "Observe a defined group over time." role=caption
  table @matrix columns=["Dimension", "Evidence"] {
   row @question cells=["Question", "What changes over time?"]
   row @record cells=["Record", "Repeated observations"]
   row @limit cells=["Limit", "Confounding and attrition"]
  }
 }
 node @case concept "Case study" {
  table @matrix columns=["Dimension", "Evidence"] {
   row @question cells=["Question", "How did this case unfold?"]
   row @record cells=["Record", "Documents and accounts"]
   row @limit cells=["Limit", "Case selection shapes scope"]
  }
 }
 node @synthesis concept "Evidence synthesis" {
  table @matrix columns=["Dimension", "Evidence"] {
   row @question cells=["Question", "What do studies agree on?"]
   row @record cells=["Record", "Included studies and quality"]
   row @limit cells=["Limit", "Missing or uneven studies"]
  }
 }
 node @causal note "Before a causal claim" role=warning { list @checks ["Check the comparison", "Check assignment and missing data"] }
 node @triangulate note "Combine complementary evidence" { text @detail "Use case context to interpret patterns; test explanations with new comparisons." }
 section @methods "Choosing research evidence" mode=grid layout=grid columns=1 gap=compact {
  group @primary "COLLECT PRIMARY EVIDENCE" frame=panel role=supporting layout=grid columns=3 gap=compact {
   show @experiment @cohort @case
  }
  group @secondary "REUSE AND CHALLENGE" frame=panel layout=grid columns=2 gap=compact {
   show @synthesis @causal @question @triangulate
  }
 }
}
