canvas 1
collection @grid-research-methods "Research methods evidence matrix" theme=atlas description="Illustrative method selection aid; evidence strength depends on execution." {
 node @question concept "Start with the claim" role=primary { text @detail "Choose evidence that can challenge the claim." }
 node @experiment concept "Experiment" role=success {
  table @matrix columns=["Dimension", "Evidence"] {
   row @question cells=["Question", "Did a change affect an outcome?"]
   row @record cells=["Record", "Assigned groups and outcomes"]
   row @limit cells=["Limit", "Setting may constrain transfer"]
  }
 }
 node @cohort concept "Cohort study" role=supporting {
  table @matrix columns=["Dimension", "Evidence"] {
   row @question cells=["Question", "What changes over time?"]
   row @record cells=["Record", "Repeated observations"]
   row @limit cells=["Limit", "Confounding and attrition"]
  }
 }
 node @case concept "Case study" {
  table @matrix columns=["Dimension", "Evidence"] {
   row @question cells=["Question", "How did this case unfold?"]
   row @record cells=["Record", "Documents and accounts"]
   row @limit cells=["Limit", "Case selection shapes scope"]
  }
 }
 node @synthesis concept "Evidence synthesis" {
  table @matrix columns=["Dimension", "Evidence"] {
   row @question cells=["Question", "What do studies agree on?"]
   row @record cells=["Record", "Included studies and quality"]
   row @limit cells=["Limit", "Missing or uneven studies"]
  }
 }
 node @causal note "Before a causal claim" role=warning { list @checks ["Check the comparison", "Check assignment and missing data"] }
 node @triangulate note "Combine complementary evidence" { text @detail "Use case context to interpret patterns; test explanations with new comparisons." }
 section @methods "RESEARCH METHODS / Compare questions, records and limits" mode=grid layout=grid columns=1 gap=compact {
  group @primary "COLLECT PRIMARY EVIDENCE" layout=grid columns=3 gap=compact {
   show @experiment @cohort @case
  }
  group @secondary "REUSE AND CHALLENGE" layout=grid columns=4 gap=compact {
   show @synthesis @causal @question @triangulate
  }
 }
}
