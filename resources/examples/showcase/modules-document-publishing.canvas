canvas 1
collection @modules-document-publishing "Document publishing boundary" theme=atlas {
 node @editor module "Editorial workspace" role=primary size=large {
  port @drafts out "drafts" type="DraftRepository"
  port @publish out "publisher" type="PublicationPort"
 }
 node @publication interface "PublicationPort" role=supporting size=medium {
  member @submit "submit" type="(ApprovedDraft) => Promise<PublicationReceipt>" visibility=public
  member @withdraw "withdraw" type="(PublicationId, Reason) => Promise<WithdrawalReceipt>" visibility=public
 }
 node @validate function "validateApproval" size=medium {
  signature @call "validateApproval" parameters=["draft: Draft", "policy: EditorialPolicy"] returns="Result<ApprovedDraft, ValidationError>"
 }
 node @web-adapter module "Web publisher adapter" role=success size=large {
  port @input in "approved draft" type="ApprovedDraft"
  port @remote out "CMS client" type="CmsClient"
 }
 node @cms interface "External CMS" role=warning size=small {
  member @create "createPage" type="(CmsPage) => Promise<CmsPageId>" visibility=public
 }
 wire @checks @editor.@drafts -> @validate "validates approval with" kind=calls
 wire @imports @editor.@publish -> @publication "depends on publishing contract" kind=imports
 wire @implements @web-adapter.@input -> @publication.@submit "implements submit" kind=implements
 wire @calls-cms @web-adapter.@remote -> @cms "imports the external CMS contract" kind=imports
 section @publishing-boundary "PUBLISHING / Policy inside, vendor outside" mode=modules layout=grid columns=2 direction=right gap=compact {
  show @editor @validate @publication @web-adapter @cms
  connect @checks @imports @implements @calls-cms
 }
}
