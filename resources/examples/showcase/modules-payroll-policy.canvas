canvas 1
collection @modules-payroll-policy "Payroll calculation contracts" theme=paper {
 node @run module "Payroll run" role=primary {
  port @policy out "policy" type="PayPolicy"
  port @rounding out "rounding" type="RoundingPolicy"
  port @calculate out "calculate" type="PayCalculator"
 }
 node @policy interface "PayPolicy" role=supporting {
  member @gross "gross" type="(WorkPeriod, Rate) => Money" visibility=public
  member @deduct "deductions" type="(Money, TaxProfile) => Money" visibility=public
 }
 node @rounding interface "RoundingPolicy" {
  member @round "round" type="(Money, Currency) => Money" visibility=public
 }
 node @calculate function "calculatePay" size=large {
  signature @call "calculatePay" parameters=["period: WorkPeriod", "policy: PayPolicy", "rounding: RoundingPolicy"] returns="PayStatement"
 }
 node @gross function "grossPay" {
  signature @call "grossPay" parameters=["period: WorkPeriod", "rate: Rate"] returns="Money"
 }
 node @deduct function "deductions" {
  signature @call "deductions" parameters=["gross: Money", "profile: TaxProfile"] returns="Money"
 }
 node @round function "roundMoney" {
  signature @call "roundMoney" parameters=["value: Money", "currency: Currency"] returns="Money"
 }
 wire @imports-policy @run.@policy -> @policy "imports pay rules" kind=imports
 wire @imports-rounding @run.@rounding -> @rounding "imports rounding rules" kind=imports
 wire @imports-calculator @run.@calculate -> @calculate "imports calculator" kind=imports
 wire @call-gross @calculate -> @gross "calculates gross" kind=calls
 wire @call-deduct @calculate -> @deduct "calculates deductions" kind=calls
 wire @call-round @calculate -> @round "rounds net amount" kind=calls
 wire @gross-policy @gross -> @policy.@gross "implements gross" kind=implements
 wire @deduct-policy @deduct -> @policy.@deduct "implements deductions" kind=implements
 wire @round-policy @round -> @rounding.@round "implements round" kind=implements
 section @payroll "PAYROLL / Callable rules behind two contracts" mode=modules layout=layered direction=down gap=compact {
  group @contracts "RULE CONTRACTS" { show @policy @rounding }
  group @functions "PURE CALCULATION" { show @calculate @gross @deduct @round }
  show @run
  connect @imports-policy @imports-rounding @imports-calculator @call-gross @call-deduct @call-round @gross-policy @deduct-policy @round-policy
 }
}
