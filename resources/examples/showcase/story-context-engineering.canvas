canvas 1
collection @story-context-engineering "Context engineering" theme=studio description="A teaching summary of context-management practice for language models. It explains one mental model, not a vendor specification; specific limits and behaviors differ by model and product." {
  node @select concept "Select what enters" frame=none composition=media-top {
    figure @figure gate pass=few size=large
    text @detail "Retrieve widely, then admit only what serves the task." role=caption
  }
  node @rank-rules note "Principles for admission" frame=card {
    text @first "1. Retrieve before ranking." role=caption
    text @second "2. Every token must earn its place." role=caption
  }
  node @assemble concept "Assemble in order" frame=none composition=media-top {
    figure @figure stack layers=some size=large
    text @detail "Stable instructions first, volatile evidence next." role=caption
  }
  node @order-rules note "Principles for order" frame=card {
    text @first "1. Instructions before evidence." role=caption
    text @second "2. Volatile closest to the question." role=caption
  }
  node @window concept "Fill the window" frame=none composition=media-top {
    figure @figure window fill=full size=large
    text @detail "Every token competes for the same finite space." role=caption
  }
  node @respond concept "Answer within budget" frame=card {
    text @detail "Reserve output room; a full window is not a finished prompt." role=caption
  }
  node @context-window concept "03 / FILL THE WINDOW" {}
  node @cost note "Recall fades as it fills" frame=none composition=media-top {
    figure @figure gauge level=full size=small
    text @detail "Long, crowded windows dilute attention across more tokens." role=caption
  }
  node @lost note "Lost in the middle" role=warning frame=card composition=media-top {
    figure @figure window fill=half size=small
    text @detail "Evidence placed mid-window is recalled least; leads and ends win." role=caption
  }
  node @poison note "Poisoned context" role=warning frame=card composition=media-top {
    figure @figure gate pass=one size=small
    text @detail "One unvetted document steers every later answer." role=caption
  }
  node @defend note "Defend the window" role=success frame=card {
    text @first "1. Leads and ends carry recall." role=caption
    text @second "2. Vet every source." role=caption
    text @third "3. Leave room for the answer." role=caption
  }

  wire @selected @select -> @assemble "ranked candidates" kind=flow step=1
  wire @ordered @assemble -> @window "ordered context" kind=flow step=2
  wire @answered @window -> @respond "within budget" kind=flow step=3
  wire @middle @lost -> @context-window "mid-window recall drops" kind=reference style=dashed
  wire @steering @poison -> @context-window "unvetted sources steer output" kind=reference style=dashed

  section @engineering "Context engineering" mode=story layout=grid columns=2 direction=right gap=normal {
    group @train "BUILD THE CONTEXT" frame=none layout=grid columns=1 direction=down gap=normal {
      group @select-stage "01 / EARN YOUR PLACE" frame=panel role=supporting layout=grid columns=2 direction=right gap=normal {
        show @select @rank-rules
      }
      group @order-stage "02 / ASSEMBLE IN ORDER" frame=panel role=decision layout=grid columns=2 direction=right gap=normal {
        show @assemble @order-rules
      }
      group @load-stage "03 / FILL THE WINDOW" represents=@context-window frame=panel role=success layout=grid columns=2 direction=right gap=normal {
        show @window @respond
      }
    }
    group @risks "WATCH THE FAILURE MODES" frame=panel role=decision layout=grid columns=1 direction=down gap=roomy {
      show @cost @lost @poison @defend
    }
    connect @selected source-side=right target-side=left
    connect @ordered source-side=bottom target-side=top
    connect @answered source-side=right target-side=left
    connect @middle @steering source-side=bottom target-side=right
  }
}
