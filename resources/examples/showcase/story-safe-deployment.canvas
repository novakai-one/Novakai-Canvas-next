canvas 1
collection @story-safe-deployment "Deploy safely and learn" theme=paper {
 asset @shield image source="./assets/shield.svg" alt="A shield with a check mark"
 asset @release image source="./assets/release.svg" alt="A release package moving forward"
 asset @evidence image source="./assets/evidence.svg" alt="A document with a magnifying lens"
 node @prepare concept "1 · Prepare" role=primary size=large { icon @symbol asset=@shield size=large text @detail "Define safety checks and a reversible release." }
 node @release-stage concept "2 · Release narrowly" role=supporting size=large { icon @symbol asset=@release size=large text @detail "Expose a small cohort before broad rollout." }
 node @learn concept "3 · Learn from signals" role=success size=large { icon @symbol asset=@evidence size=large text @detail "Compare expected and observed behavior." }
 node @checks note "Prove readiness" size=small { list @detail ["Migration rehearsed", "Rollback tested", "Owner present"] }
 node @cohort note "Limit the blast radius" size=medium { text @detail "Start with internal or low-risk traffic." }
 node @healthy note "Healthy signal" role=success size=small { text @detail "Expand only when guardrails remain green." }
 node @unsafe note "Unsafe signal" role=warning size=small { text @detail "Pause, roll back and preserve evidence." }
 node @record note "Close the loop" size=medium { text @detail "Record the outcome and update the next release plan." }
 section @deployment-story "SAFE DEPLOYMENT / Confidence grows through evidence" mode=story layout=grid columns=1 direction=down gap=compact {
  group @before-expansion "BEFORE INCREASING TRAFFIC" layout=grid columns=2 direction=right gap=compact {
   group @prepare-column "PREPARE" represents=@prepare layout=grid columns=1 gap=compact { show @checks }
   group @release-column "RELEASE" represents=@release-stage layout=grid columns=1 gap=compact { show @cohort }
  }
  group @learn-column "LEARN" represents=@learn layout=grid columns=3 direction=right gap=compact {
   show @healthy @unsafe @record
  }
 }
}
