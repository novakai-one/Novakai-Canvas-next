canvas 1
collection @story-water-treatment-figures "How water treatment uses several barriers" theme=studio description="Simplified conventional treatment explanation drawn entirely from parametric figures; no hand-authored assets. Actual barriers and operating limits depend on source-water risks; this is not an operating procedure." {
  node @source concept "Screen the intake" frame=none composition=media-top {
    figure @figure screen debris=some size=large
    text @detail "Intercept large debris before treatment." role=caption
  }
  node @settle concept "Gather and settle" frame=none composition=media-top {
    figure @figure vessel level=half agitator=true size=large
    text @detail "Gather fine particles into floc that can settle." role=caption
  }
  node @filter concept "Filter the water" frame=none composition=media-top {
    figure @figure layered-bed level=full size=large
    text @detail "Pass clarified water through filter media." role=caption
  }
  node @disinfect concept "Apply disinfection" frame=none composition=media-top {
    figure @figure vessel level=half mark=check size=large
    text @detail "Apply the selected, controlled disinfection barrier." role=caption
  }
  node @supply concept "Protect distribution" frame=none composition=media-top {
    figure @figure vessel level=full mark=shield size=large
    text @detail "Protect treated water in storage and the network." role=caption
  }
  node @barrier-system concept "02 / TREAT THE WATER" {}
  node @monitor note "Check performance" frame=none composition=media-top {
    figure @figure gauge level=half size=small
    text @detail "Samples and instruments check filtration and disinfection." role=caption
    text @legend "Dashed arrows = monitoring, not water transport." role=annotation
  }
  node @residuals note "Separate residuals" role=warning frame=card {
    text @detail "Settled solids and filter wash water require separate handling." role=caption
  }
  node @limits note "One barrier is not enough" role=success frame=card {
    text @detail "Each stage addresses a different part of the source-water risk." role=caption
    text @scope "The source determines the necessary barriers and operating limits." role=annotation
  }

  wire @intake @source -> @settle "screened source water" kind=flow step=1
  wire @clarified @settle -> @filter "clarified water" kind=flow step=2
  wire @filtered @filter -> @disinfect "filtered water" kind=flow step=3
  wire @treated @disinfect -> @supply "treated water" kind=flow step=4
  wire @solids @settle -> @residuals "settled solids" kind=flow
  wire @wash @filter -> @residuals "filter wash water" kind=flow
  wire @barrier-check @monitor -> @barrier-system "checks both barriers" kind=reference style=dashed

  section @treatment "Water treatment" mode=story layout=grid columns=2 direction=right gap=normal {
    group @train "A SEQUENCE OF BARRIERS" frame=none layout=grid columns=1 direction=down gap=normal {
      group @intake-stage "01 / REMOVE PARTICLES" frame=panel role=supporting layout=grid columns=2 direction=right gap=normal {
        show @source @settle
      }
      group @barriers "02 / TREAT THE WATER" represents=@barrier-system frame=panel role=success layout=grid columns=2 direction=right gap=normal {
        show @disinfect @filter
      }
      group @delivery "03 / KEEP IT PROTECTED" frame=panel layout=grid columns=2 direction=right gap=normal {
        show @supply @limits
      }
    }
    group @oversight "OBSERVE + HANDLE SIDE STREAMS" frame=panel role=decision layout=grid columns=1 direction=down gap=roomy {
      show @monitor @residuals
    }
    connect @intake source-side=right target-side=left
    connect @clarified source-side=bottom target-side=top
    connect @filtered source-side=left target-side=right
    connect @treated source-side=bottom target-side=top
    connect @solids @wash source-side=right target-side=left
    connect @barrier-check source-side=bottom target-side=right
  }
}
