canvas 1
collection @story-water-treatment "How water treatment uses several barriers" theme=studio description="Simplified conventional treatment explanation. Actual barriers and operating limits depend on source-water risks; this is not an operating procedure." {
  asset @water image source="./assets/water.svg" alt="Water moving through treatment"
  asset @evidence image source="./assets/evidence.svg" alt="A recorded observation"
  asset @shield image source="./assets/shield.svg" alt="A treatment barrier"

  node @source concept "1. Screen the intake" role=primary frame=none composition=media-top {
    icon @symbol asset=@water size=small
    text @detail "Remove large debris from incoming water." role=caption
  }
  node @settle concept "2. Form and settle floc" role=supporting frame=none composition=media-top {
    icon @symbol asset=@water size=small
    text @detail "Gather fine particles into floc that can settle." role=caption
  }
  node @filter concept "3. Filter" role=supporting frame=none composition=media-top {
    icon @symbol asset=@shield size=small
    text @detail "Pass clarified water through filter media." role=caption
  }
  node @disinfect concept "4. Disinfect" role=success frame=none composition=media-top {
    icon @symbol asset=@shield size=small
    text @detail "Apply the selected controlled disinfection barrier." role=caption
  }
  node @supply concept "5. Protect storage and distribution" role=success frame=none composition=media-top {
    icon @symbol asset=@water size=small
    text @detail "Protect treated water as it enters the network." role=caption
  }
  node @monitor note "Observe the barriers" role=primary frame=none composition=media-top {
    icon @symbol asset=@evidence size=small
    text @detail "Samples and instruments inform treatment checks. Dashed links show monitoring, not water transport." role=caption
  }
  node @residuals note "Handle residual streams" role=warning {
    text @detail "Settled solids and filter wash water require separate handling." role=caption
  }
  node @limits note "Select barriers for the source" {
    text @detail "No single barrier addresses every contaminant. The source-water risks determine the process." role=caption
  }

  wire @intake @source -> @settle "screened water" kind=flow
  wire @clarified @settle -> @filter "clarified water" kind=flow
  wire @filtered @filter -> @disinfect "filtered water" kind=flow
  wire @treated @disinfect -> @supply "treated water" kind=flow
  wire @solids @settle -> @residuals "settled solids" kind=flow
  wire @wash @filter -> @residuals "filter wash water" kind=flow
  wire @filter-check @monitor -> @filter "checks filtration" kind=reference style=dashed
  wire @disinfection-check @monitor -> @disinfect "checks disinfection" kind=reference style=dashed

  section @treatment "Water treatment" mode=story layout=grid columns=1 direction=down gap=normal {
    group @intake-stage "REMOVE PARTICLES" frame=panel role=supporting layout=grid columns=2 gap=normal {
      show @source @settle
    }
    group @barriers "TREAT AND PROTECT" frame=panel role=neutral layout=grid columns=3 gap=normal {
      show @filter @disinfect @supply
    }
    group @oversight "MONITORING AND SEPARATE STREAMS" frame=panel role=supporting layout=grid columns=2 gap=normal {
      show @monitor @residuals
    }
    show @limits
    connect @intake source-side=right target-side=left
    connect @clarified source-side=bottom target-side=top
    connect @filtered @treated source-side=right target-side=left
    connect @solids @wash source-side=bottom target-side=top
    connect @filter-check @disinfection-check source-side=top target-side=bottom
  }
}
