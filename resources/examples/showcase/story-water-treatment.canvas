canvas 1
collection @story-water-treatment "How water treatment uses several barriers" theme=atlas description="Simplified conventional treatment story; processes vary with source water." {
 asset @water image source="./assets/water.svg" alt="Water drop: water moving through treatment"
 asset @evidence image source="./assets/evidence.svg" alt="Inspection document: sample and check"
 asset @shield image source="./assets/shield.svg" alt="Shield: a protective treatment barrier"
 node @source concept "1. Source and screen" role=primary { icon @symbol asset=@water size=medium text @detail "Remove large debris at the intake." }
 node @settle concept "2. Form and settle floc" { icon @symbol asset=@water size=medium text @detail "Gather fine particles into floc that can settle." }
 node @filter concept "3. Filter" role=supporting { icon @symbol asset=@shield size=medium text @detail "Pass clarified water through filter media." }
 node @disinfect concept "4. Disinfect" role=success { icon @symbol asset=@shield size=medium text @detail "Apply a controlled disinfection step." }
 node @monitor note "Check at each barrier" role=primary { icon @symbol asset=@evidence size=medium text @detail "Samples and instruments track treatment performance." }
 node @residuals note "A second material stream" role=warning { text @detail "Settled solids and filter wash water need separate handling." }
 node @limits note "Water quality sets the process" { text @detail "No single barrier addresses every contaminant." }
 node @supply concept "5. Store and distribute" role=success { icon @symbol asset=@water size=medium text @detail "Protect treated water as it reaches the network." }
 section @treatment "WATER TREATMENT / Follow water and its checks" mode=story layout=grid columns=2 direction=right gap=compact {
  group @water-path "WATER PATH" layout=grid columns=2 gap=compact { show @source @settle @filter @disinfect }
  group @oversight "ALONGSIDE TREATMENT" layout=grid columns=1 gap=compact { show @monitor @residuals }
  show @supply @limits
 }
}
