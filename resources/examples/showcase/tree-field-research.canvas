canvas 1
collection @tree-field-research "Design a field study" theme=atlas {
 node @study concept "Field study" role=primary { text @detail "A question connected to observable evidence." }
 node @question concept "Question" { text @detail "What changes between the two habitats?" }
 node @sampling concept "Sampling" role=supporting {}
 node @sites concept "Sites" { list @detail ["Wetland edge", "Upstream reference"] }
 node @timing concept "Timing" { text @detail "Repeat at dawn and after rainfall." }
 node @records concept "Records" role=success {}
 node @observations concept "Observations" { list @detail ["Species count", "Water clarity"] }
 node @context concept "Context" { list @detail ["Weather", "Observer", "Equipment"] }
 wire @ask @study -> @question "defines" kind=parent
 wire @plan @study -> @sampling "plans" kind=parent
 wire @keep @study -> @records "retains" kind=parent
 wire @where @sampling -> @sites "where" kind=parent
 wire @when @sampling -> @timing "when" kind=parent
 wire @measure @records -> @observations "measures" kind=parent
 wire @explain @records -> @context "explains" kind=parent
 section @field-research "FIELD STUDY / Make evidence comparable" mode=tree direction=right gap=compact {
  show @study @question @sampling @sites @timing @records @observations @context
  connect @ask @plan @keep @where @when @measure @explain
  root @study
 }
}
