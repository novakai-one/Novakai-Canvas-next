canvas 1
collection @tree-incident-causes "Incident cause hypotheses" theme=paper description="Illustrative investigation map; branches are hypotheses, not established causes." {
 node @incident concept "Checkout interruption" role=primary { text @detail "Explain the interruption using evidence." }
 node @trigger concept "Trigger" role=warning {}
 node @deploy concept "Configuration release" { text @detail "Compare the deployed limit with the prior value." }
 node @capacity concept "Capacity conditions" role=supporting {}
 node @pool concept "Connection pool exhausted" {}
 node @held concept "Connections held too long" {}
 node @timeout concept "Missing query timeout" { text @detail "Inspect slow-query traces and cancellation." }
 node @traffic concept "Traffic concentration" { text @detail "Compare arrival rate across partitions." }
 node @detection concept "Detection gap" { text @detail "Check why user errors preceded the page." }
 node @recovery concept "Recovery friction" {}
 node @runbook concept "Unclear rollback owner" { text @detail "Compare handover notes with the incident timeline." }
 wire @trigger-branch @incident -> @trigger "possible trigger" kind=parent
 wire @release @trigger -> @deploy "candidate change" kind=parent
 wire @capacity-branch @incident -> @capacity "possible amplifier" kind=parent
 wire @pool-path @capacity -> @pool "resource symptom" kind=parent
 wire @held-path @pool -> @held "possible mechanism" kind=parent
 wire @timeout-path @held -> @timeout "candidate control gap" kind=parent
 wire @traffic-path @capacity -> @traffic "alternate pressure" kind=parent
 wire @detect-branch @incident -> @detection "time to notice" kind=parent
 wire @recover-branch @incident -> @recovery "time to recover" kind=parent
 wire @owner-path @recovery -> @runbook "candidate delay" kind=parent
 section @causes "INCIDENT CAUSES / Test branches against the timeline" mode=tree layout=tree direction=down gap=compact {
  show @incident @trigger @deploy @capacity @pool @held @timeout @traffic @detection @recovery @runbook
  connect @trigger-branch @release @capacity-branch @pool-path @held-path @timeout-path @traffic-path @detect-branch @recover-branch @owner-path
  root @incident
 }
}
