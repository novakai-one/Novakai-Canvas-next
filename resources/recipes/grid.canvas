canvas 1
collection @comparison "Compare three delivery approaches" theme=paper {
  node @guided concept "Guided workshop" role=primary {
    text @summary "Work through the problem together in a fixed session."
  }
  node @guided-strength note "Fast shared understanding" role=success {
    list @points ["Questions answered immediately", "Decisions made with the group"]
  }
  node @guided-limit note "Needs a common time" role=warning {
    text @detail "Record the outcome for anyone who cannot attend."
  }
  node @self concept "Self-paced guide" role=supporting {
    text @summary "Let each reader follow the material when it suits them."
  }
  node @self-strength note "Easy to revisit" role=success {
    list @points ["Scales across time zones", "Supports individual pacing"]
  }
  node @self-limit note "Questions arrive later" role=warning {
    text @detail "Provide a clear feedback and escalation path."
  }
  node @paired concept "Paired practice" {
    text @summary "Learn by completing a realistic task with a partner."
  }
  node @paired-strength note "Immediate applied feedback" role=success {
    list @points ["Exposes hidden assumptions", "Builds confidence through practice"]
  }
  node @paired-limit note "Quality depends on the pairing" role=warning {
    text @detail "Rotate partners and provide a worked reference."
  }
  section @options "Delivery options at a glance" mode=grid layout=grid columns=3 gap=compact {
    group @guided-panel "GUIDED" represents=@guided layout=grid columns=1 gap=compact {
      show @guided-strength @guided-limit
    }
    group @self-panel "SELF-PACED" represents=@self layout=grid columns=1 gap=compact {
      show @self-strength @self-limit
    }
    group @paired-panel "PAIRED" represents=@paired layout=grid columns=1 gap=compact {
      show @paired-strength @paired-limit
    }
  }
}
