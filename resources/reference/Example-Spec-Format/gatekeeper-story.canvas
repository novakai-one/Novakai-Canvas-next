  node @mg-surface module "Canvas surface" size=medium {
    code @mg-surface-x "landDrop()"
    text @mg-surface-d "change — hosts the keep-in / move-out / cancel popup. Popup UI lives here in adapters, not in core." role=caption
  }
  node @mg-drop module "Drop choice (new)" role=primary size=medium {
    signature @mg-drop-sig "askMeaning" parameters=["drop: LandedDrop"] returns="DropMeaning"
    text @mg-drop-d "new — the only new file; pure decision logic in canvas/core/drafts/, beside drafts/regroup.ts which already detects regroup intent. The popup itself is CanvasSurface." role=caption
  }
  node @mg-session module "Workspace session" size=medium {
    signature @mg-session-sig "submit" parameters=["move: NodeMove", "meaning: DropMeaning"] returns="void"
    text @mg-session-d "change — loses the edit-lock wiring and the movement review; the gatekeeper becomes a messenger. submit() is a proposed name." role=caption
  }
  node @mg-capture module "Movement capture" size=medium {
    signature @mg-capture-sig "captureMove" parameters=["move: NodeMove", "meaning: DropMeaning"] returns="MoveCapture"
    text @mg-capture-d "change — the 'captured group missing' throw dies; a group-edge drop is captured as a question. captureMove() is a proposed name." role=caption
  }
  node @mg-planner module "Edit planner" size=medium {
    signature @mg-planner-sig "planRegroup" parameters=["capture: MoveCapture"] returns="EditRequest"
    text @mg-planner-d "change — plan.ts + regroup.ts: plans both meanings (keep-in via expand, move-out via section replace, regroupSections at regroup.ts:25); stops deciding legality itself. planRegroup() is a proposed name." role=caption
  }
  node @mg-expand module "Movement expand" size=medium {
    signature @mg-expand-sig "buildExpandOption" parameters=["intent: MoveIntent", "context: MoveContext"] returns="Result<MoveOption | null>"
    text @mg-expand-d "change — buildExpandOption() exists today (:52) but is modules-only (:90-93) and borrows the in-browser preview (:85-86). The rewire: its preview comes from the SERVER preview instead. Keep-in on plain groups (flow, tree, er, sequence) is NEW work — no mode has group-grow today. Real signature this time." role=caption
  }
  node @mg-routes module "Route preview — demoted" size=medium {
    signature @mg-routes-sig "adviseRoutes" parameters=["request: EditRequest"] returns="RouteAdvice"
    text @mg-routes-d "change — calls the existing server preview; the in-browser module solve is deleted. adviseRoutes() is a proposed name." role=caption
  }
  node @mg-journal module "Submission session" size=medium {
    signature @mg-journal-sig "reconcile" parameters=["entry: Submission"] returns="Receipt | Retry"
    text @mg-journal-d "change — a reconcile path for uncertain entries (transport failure), reusing reconcile/retry (:137-194). 'rejected' already frees the next edit (PR #104)." role=caption
  }
  node @mg-diagnostics module "Diagnostics — human words (web)" size=medium {
    signature @mg-diagnostics-sig "toHumanWords" parameters=["rejection: TypedRejection"] returns="HumanWords"
    text @mg-diagnostics-d "change — extends the plain-English mapping that already exists (apps/web/core/output/diagnostics.ts, PR #104). toHumanWords is a proposed name." role=caption
  }
  node @mg-door module "Admission — the door" size=small {
    signature @mg-door-sig "admit" parameters=["actor: Actor", "request: EditRequest"] returns="Admitted | Refused"
    text @mg-door-d "existing — POST /api/v1/authoring/preview and /apply already admit humans (http-router.ts:194-195). Per-author planners stay here (admission.ts:76)." role=caption
  }
  node @mg-judge module "The judge — authoring pipeline" role=primary size=medium {
    signature @mg-preview-sig "prepare" parameters=["input: EditRequest", "preview: true"] returns="Candidate | Rejection"
    signature @mg-apply-sig "apply" parameters=["request: EditRequest"] returns="Receipt"
    text @mg-judge-d "existing + small change — prepare(preview) and withCandidate's checks already exist (authoring/contract/api.ts:48-71); the change is surfacing typed reasons, not building a pipeline." role=caption
  }
  node @mg-rulebook module "Law: Rulebook — Model planner" size=small {
    signature @mg-rulebook-sig "validate" parameters=["request: EditRequest"] returns="Verdict — legal | illegal + reasons"
    text @mg-rulebook-d "existing — the law itself is unchanged; the change is contractual: the verdict carries reasons (which rule broke, why)." role=caption
  }
  node @mg-geometry module "Law: Geometry — feasibility render" size=small {
    signature @mg-geometry-sig "checkFeasibility" parameters=["scene: Scene"] returns="Verdict — drawable | not drawable + reasons"
    text @mg-geometry-d "existing — the feasibility step (pipeline.ts:32, private today) backed by apps/service/adapters/feasibility.ts; runs a full render job on every apply and a 'no' carries the constraint conflict." role=caption
  }
  node @mg-store module "Law: Store — Persistence" size=small {
    signature @mg-store-sig "commit" parameters=["tx: Transaction"] returns="Receipt"
    text @mg-store-d "existing — unchanged." role=caption
  }
  node @mg-note note "Every wire names the function it calls; the target card carries its signature with return type — so no return wires. existing = real code today (file:line cited); new / proposed names are marked. Every request crosses one door (admit) before the judge." size=medium {}

  wire @mg-w1 @mg-surface -> @mg-drop.@mg-drop-sig "calls askMeaning(): DropMeaning (new)" kind=calls
  wire @mg-w2 @mg-surface -> @mg-session.@mg-session-sig "calls submit(move, meaning): void" kind=calls
  wire @mg-w3 @mg-session -> @mg-capture.@mg-capture-sig "calls captureMove(): MoveCapture" kind=calls
  wire @mg-w4 @mg-session -> @mg-planner.@mg-planner-sig "calls planRegroup(): EditRequest" kind=calls
  wire @mg-w5 @mg-session -> @mg-routes.@mg-routes-sig "calls adviseRoutes(): RouteAdvice" kind=calls
  wire @mg-w6 @mg-session -> @mg-journal.@mg-journal-sig "calls reconcile(): Receipt | Retry" kind=calls
  wire @mg-w7 @mg-planner -> @mg-expand.@mg-expand-sig "imports buildExpandOption(): ExpandOption (existing)" kind=imports
  wire @mg-w8 @mg-journal -> @mg-door.@mg-door-sig "calls admit(): Admitted | Refused (existing route)" kind=calls
  wire @mg-w9 @mg-judge -> @mg-rulebook.@mg-rulebook-sig "calls validate(): Verdict — legal | illegal + reasons" kind=calls
  wire @mg-w10 @mg-judge -> @mg-geometry.@mg-geometry-sig "calls checkFeasibility(): Verdict — drawable | not drawable + reasons (existing)" kind=calls
  wire @mg-w11 @mg-judge -> @mg-store.@mg-store-sig "calls commit(): Receipt" kind=calls
  wire @mg-w12 @mg-door -> @mg-judge.@mg-apply-sig "calls apply(): Receipt (existing)" kind=calls
  wire @mg-w13 @mg-door -> @mg-judge.@mg-preview-sig "calls prepare(preview): Candidate | Rejection (existing)" kind=calls
  wire @mg-w14 @mg-journal -> @mg-diagnostics.@mg-diagnostics-sig "calls toHumanWords(): HumanWords (proposed)" kind=calls

  node @be-request entity "EditRequest" {
    field @be-request-id "request" type="RequestId" key=primary
    field @be-request-ws "workspace" type="WorkspaceId"
    field @be-request-actor "actor" type="{ id, kind: human | agent }"
    field @be-request-version "version" type="1"
    field @be-request-exp "expected" type="Version[]"
    field @be-request-scope "scope" type="Key[]"
    field @be-request-assets "assets" type="AssetRef[]"
    field @be-request-intent "intent" type="Intent"
    text @be-request-d "existing — unchanged; the real record (authoring/contract/records/request.ts:12-21). scope is what decides whether an edit is blocked (submissions.ts:13)." role=caption
  }
  node @be-receipt entity "Receipt" {
    field @be-receipt-id "id" type="ReceiptId" key=primary
    field @be-receipt-request "request_id" type="RequestId" key=foreign references=@be-request.@be-request-id
    field @be-receipt-rev "new_revision" type="integer"
    text @be-receipt-d "existing — commit-only; refusals are not persisted, they return as typed rejections (submission-session.ts:18-22)." role=caption
  }
  node @be-journal entity "Submission (journal)" {
    field @be-journal-id "id" type="EntryId" key=primary
    field @be-journal-request "request_id" type="RequestId" key=foreign references=@be-request.@be-request-id
    field @be-journal-state "state" type="sending | uncertain | retryable | rejected | abandoned (proposed)"
    text @be-journal-d "change — 'rejected' already frees the next edit (PR #104), and recovery buttons already exist (RequestRecovery.tsx). The remaining gap: a 'retryable' edit (no receipt found) blocks and cannot be dismissed — the build adds 'abandoned'. Real states: contract/records/submission.ts:12." role=caption
  }
  node @be-note note "Transient objects — LandedDrop, DropMeaning, previews — are never persisted, so they are not entities. No entity is deleted." size=medium {}

  wire @be-w1 @be-receipt -> @be-request "answers" kind=association from="1" to="1"
  wire @be-w2 @be-journal -> @be-request "tracks" kind=association from="0..many" to="1"

  node @cs-table-node concept "Change summary — third count, file by file" role=primary size=large {
    table @cs-table columns=["new/change/remove", "File", "Role — what the builder should know", "Current lines", "Lines added (est)", "Lines removed (est)", "Final lines (est)"] {
      row @cs-r1 cells=["change", "apps/web/adapters/workspace-session.ts", "loses the edit-lock wiring and the movement review call sites (~512 lines of move/review code); the gatekeeper becomes a messenger — see refactor flag below", "2905", "+40", "-500", "2445"]
      row @cs-r2 cells=["change", "apps/web/core/editing/movement-capture.ts", "the 'captured group missing' throw dies; a group-edge drop is captured as a question", "427", "+90", "-60", "457"]
      row @cs-r3 cells=["change", "apps/web/core/editing/plan.ts", "plans both meanings of an ambiguous drop; stops deciding legality itself", "67", "+30", "-15", "82"]
      row @cs-r4 cells=["change", "apps/web/core/editing/regroup.ts", "move-out is already a model section replace (regroupSections, :25); extended for the explicit move-out meaning", "43", "+55", "0", "98"]
      row @cs-r5 cells=["change", "apps/web/core/editing/movement.ts", "the review core itself (buildMoveReview, chooseMoveOption, :20/:127) — gutted with the review teardown", "146", "+10", "-120", "36"]
      row @cs-r6 cells=["change", "apps/web/core/editing/movement-expand.ts", "keep-in: expand rewired so its preview comes from the server, plus NEW generic keep-in for plain groups (expand is modules-only today)", "556", "+140", "-40", "656"]
      row @cs-r7 cells=["change", "apps/web/core/editing/movement-rearrange.ts", "gutted: the rearrange review dies; what survives moves under the judge's preview", "795", "+20", "-700", "115"]
      row @cs-r8 cells=["change", "apps/web/core/editing/movement-preview.ts", "review preview demoted; server preview replaces it", "313", "+10", "-260", "63"]
      row @cs-r9 cells=["change", "apps/web/core/editing/movement-intent.ts", "part dies with the review — but expand uses ~300 lines of it, so most survives", "367", "+10", "-120", "257"]
      row @cs-r10 cells=["remove", "apps/web/adapters/react/MovementReview.tsx", "the review popup UI; replaced by the drop-choice popup in CanvasSurface", "146", "0", "-146", "0"]
      row @cs-r11 cells=["change", "apps/web/contract/records/movement.ts", "review record types shrink to what the popup needs", "57", "+5", "-40", "22"]
      row @cs-r12 cells=["change", "apps/web/core/editing/submissions.ts", "blocksSubmission() learns to ignore abandoned entries (scope decides blocking, :13)", "66", "+10", "-5", "71"]
      row @cs-r13 cells=["change", "apps/web/contract/records/submission.ts", "adds the 'abandoned' state (proposed)", "38", "+5", "0", "43"]
      row @cs-r14 cells=["change", "apps/web/adapters/submission-session.ts", "a retryable edit (no receipt found) can be dismissed; reconcile/retry already exist (:137-194)", "213", "+30", "-5", "238"]
      row @cs-r15 cells=["change", "apps/web/adapters/react/RequestRecovery.tsx", "the existing recovery buttons (:71, :78) gain 'abandon'", "100", "+10", "0", "110"]
      row @cs-r16 cells=["change", "apps/web/contract/compose.ts", "wiring: review machinery out, popup and preview in (:254-276, :355-357)", "533", "+10", "-30", "513"]
      row @cs-r17 cells=["change", "apps/web/adapters/route-preview.ts", "adviser: calls the existing server preview; in-browser solve deleted", "108", "+30", "-70", "68"]
      row @cs-r18 cells=["change", "apps/web/core/output/diagnostics.ts", "extends the plain-English mapping (PR #104) with the laws' typed reasons", "63", "+45", "0", "108"]
      row @cs-r19 cells=["change", "capability/canvas/adapters/react-flow/CanvasSurface.tsx", "hosts the keep-in / move-out / cancel popup at the drop spot", "227", "+65", "-10", "282"]
      row @cs-r20 cells=["new", "capability/canvas/core/drafts/drop-choice.ts", "the only new file; pure logic turning a landed drop into the three-way question", "0", "+120", "0", "120"]
      row @cs-r21 cells=["change", "capability/canvas/core/drafts/regroup.ts", "edge-ambiguity detection extends today's regroup draft (:31-53)", "75", "+25", "0", "100"]
      row @cs-r22 cells=["change", "capability/canvas/core/interaction/changes.ts", "second edit lock removed (:22)", "25", "+5", "-10", "20"]
      row @cs-r23 cells=["change", "apps/service/core/transport/admission.ts", "per-author planners stay; turn-taking admission tweaks", "110", "+10", "-5", "115"]
      row @cs-r24 cells=["change", "apps/service/adapters/diagram-planners.ts", "where revision conflicts actually originate (:55) — rebase guidance added here", "141", "+25", "-5", "161"]
      row @cs-r25 cells=["change", "apps/service/adapters/authoring-store.ts", "the other conflict source (:15) — carries the 'what changed' detail for rebase", "102", "+15", "-5", "117"]
      row @cs-r26 cells=["change", "capability/authoring/contract/api.ts", "prepare(preview) exists (:48-55); typed reasons surface in rejections", "95", "+25", "0", "120"]
      row @cs-r27 cells=["change", "apps/service/adapters/feasibility.ts", "the geometry law's adapter: render-job verdict already carries constraint conflicts", "102", "+15", "0", "117"]
      row @cs-r28 cells=["change", "apps/web/tests/movement.test.ts", "review tests deleted/rewritten for the popup (existing file, missed twice)", "286", "+40", "-200", "126"]
      row @cs-total cells=["TOTAL", "28 files — 26 changed, 1 new, 1 removed", "", "8106", "+895", "-2346", "6655"]
    }
    text @cs-note "Third count. First (+730/-575, 13 files) missed the movement-review machinery; second (+750/-2101, 24 files) missed the test file, the conflict sources, and overestimated deletions in files that surviving code shares. Estimates, not gates." role=caption
    text @cs-refactor "!! REFACTOR FLAG — workspace-session.ts is 2,905 lines: far past single responsibility, and this build leaves it at ~2,445. De-gating is its first cut, not its fix. Splitting it (session / advice / coordination) is a scope decision for this build — stage 10 in the build-plan collection." role=caption
  }

  node @ow-table-node concept "Capability ownership — who may do what to each object" size=large {
    table @ow-table columns=["Object", "Create", "Read", "Update", "Delete"] {
      row @ow-r1 cells=["EditRequest", "apps/web/core/editing/plan.ts — planRegroup() (proposed)", "capability/authoring/contract/api.ts — prepare(), apply() (existing)", "never", "never"]
      row @ow-r2 cells=["Receipt", "authoring pipeline — apply() on commit (existing)", "apps/web/adapters/submission-session.ts — receipt path (existing)", "never", "never"]
      row @ow-r3 cells=["Submission (journal)", "apps/web/adapters/submission-session.ts — submit() (existing)", "apps/web/core/editing/submissions.ts — blocksSubmission() (existing)", "submission-session.ts — reconcile()/retry() on uncertain (existing, extended)", "never"]
      row @ow-r4 cells=["Group membership", "apps/web/core/editing/movement-expand.ts — buildExpandOption() on keep-in (existing, modules-only today; plain-group keep-in is new)", "capability/layout/core (measure + arrange)", "apps/web/core/editing/regroup.ts — regroupSections() on move-out (existing)", "apps/web/core/editing/regroup.ts — same path (existing)"]
    }
    text @ow-note "File + function, with (existing) vs (proposed) marked. Where a function is named it exists on a B.3 card. scope on EditRequest decides whether an edit is blocked (submissions.ts:13)." role=caption
  }

  node @bq-you participant "You" role=primary {}
  node @bq-surface participant "Canvas surface" {}
  node @bq-session participant "Workspace session" {}
  node @bq-capture participant "Movement capture" {}
  node @bq-planner participant "Edit planner" {}
  node @bq-journal participant "Submission session" {}
  node @bq-door participant "Admission — the door" {}
  node @bq-judge participant "The judge (pipeline)" role=primary {}
  node @bq-rulebook participant "Law: Rulebook" {}
  node @bq-geometry participant "Law: Geometry (feasibility)" {}
  node @bq-store participant "Store" {}
  node @bq-diagnostics participant "Diagnostics (web)" {}
  node @bq-note note "Same function names as B.3 — if a name here is not on a card there, this spec is wrong. A law's 'no' returns a rejection carrying reasons; the browser's diagnostics mapping renders the human words." size=medium {}

  node @bo-1 step "Un-wedge: abandon the undismissable" size=medium {
    text @bo-1-d "A retryable edit (no receipt found) blocks today and cannot be dismissed. Recovery buttons already exist (PR #104); this adds 'abandon'."
  }
  node @bo-2 step "Turn-taking: rebase rules" size=medium {
    text @bo-2-d "revision-conflict learns to say what changed and how to rebase — in diagram-planners.ts and authoring-store.ts, where conflicts actually originate. Prerequisite for removing the edit lock."
  }
  node @bo-3 step "The group-edge popup" size=medium {
    text @bo-3-d "The drop lands, then keep-in / move-out / cancel — built on existing expand and regroup."
  }
  node @bo-4 step "Demote the gates" size=medium {
    text @bo-4-d "G0–G3 stop refusing; drags travel the existing preview + apply. Includes the movement-review teardown."
  }
  node @bo-5 step "Words, modules, split" size=medium {
    text @bo-5-d "Refusal words extended; modules loses special cases; workspace-session split decision."
  }
  node @bo-note note "Each step ships working software alone. Steps 1 and 2 are prerequisites, not optional polish." size=medium {}

  wire @bo-w1 @bo-1 -> @bo-2 "then" kind=flow step=1
  wire @bo-w2 @bo-2 -> @bo-3 "then" kind=flow step=2
  wire @bo-w3 @bo-3 -> @bo-4 "then" kind=flow step=3
  wire @bo-w4 @bo-4 -> @bo-5 "then" kind=flow step=4

  section @s-spec-tree "B.1 · Build spec — target repo tree (files in scope, second count)" mode=tree direction=down gap=compact order=6 {
    show @tr-root @tr-apps @tr-cap @tr-webad @tr-webreact @tr-webtests @tr-webed @tr-webout @tr-webcontract @tr-transport @tr-svcad @tr-canvasrf @tr-drafts @tr-interaction @tr-authcontract @tr-f-ws @tr-f-rp @tr-f-ss @tr-f-mr @tr-f-rr @tr-f-mvtest @tr-f-dp @tr-f-as @tr-f-plan @tr-f-regroup @tr-f-mc @tr-f-mv @tr-f-mre @tr-f-mex @tr-f-mpv @tr-f-mi @tr-f-submissions @tr-f-diag @tr-f-compose @tr-f-recmove @tr-f-recsub @tr-f-adm @tr-f-feas @tr-f-surface @tr-f-draftregroup @tr-f-drop @tr-f-changes @tr-f-api @tr-note
    connect @tr-e1 @tr-e2 @tr-e3 @tr-e4 @tr-e5 @tr-e6 @tr-e7 @tr-e8 @tr-e9 @tr-e10 @tr-e11 @tr-e12 @tr-e13 @tr-e14 @tr-e15 @tr-e16 @tr-e17 @tr-e18 @tr-e19 @tr-e20 @tr-e21 @tr-e22 @tr-e23 @tr-e24 @tr-e25 @tr-e26 @tr-e27 @tr-e28 @tr-e29 @tr-e30 @tr-e31 @tr-e32 @tr-e33 @tr-e34 @tr-e35 @tr-e36 @tr-e37 @tr-e38 @tr-e39 @tr-e40 @tr-e41 @tr-e42
    root @tr-root
  }

  section @s-spec-entities "B.2 · Build spec — entity diagram (real records, second count)" mode=er direction=right order=7 {
    show @be-request @be-receipt @be-journal @be-note
    connect @be-w1 @be-w2
  }

  section @s-spec-modules "B.3 · Build spec — module import graph (groups are folders, real functions)" mode=modules direction=right order=8 {
    group @mg-g-apps "apps/" {
      group @mg-g-web "web/" {
        group @mg-g-adapters "adapters/" {
          show @mg-session @mg-routes @mg-journal
        }
        group @mg-g-editing "core/editing/" {
          show @mg-capture @mg-planner @mg-expand
        }
        group @mg-g-output "core/output/" {
          show @mg-diagnostics
        }
      }
      group @mg-g-service "service/" {
        group @mg-g-transport "core/transport/" {
          show @mg-door
        }
        group @mg-g-svcad "adapters/" {
          show @mg-geometry
        }
      }
    }
    group @mg-g-cap "capability/" {
      group @mg-g-canvas "canvas/" {
        group @mg-g-rf "adapters/react-flow/" {
          show @mg-surface
        }
        group @mg-g-drafts "core/drafts/" {
          show @mg-drop
        }
      }
      group @mg-g-authoring "authoring/contract/" {
        show @mg-judge
      }
      group @mg-g-model "model/core/" {
        show @mg-rulebook
      }
      group @mg-g-persistence "persistence/core/" {
        show @mg-store
      }
    }
    show @mg-note
    connect @mg-w1 @mg-w2 @mg-w3 @mg-w4 @mg-w5 @mg-w6 @mg-w7 @mg-w8 @mg-w9 @mg-w10 @mg-w11 @mg-w12 @mg-w13 @mg-w14
  }

  section @s-spec-summary "B.4 · Build spec — change summary (second count, estimates not gates)" mode=flow direction=right order=9 {
    show @cs-table-node
  }

  section @s-spec-ownership "B.5 · Build spec — capability ownership (CRUD by file + function)" mode=flow direction=right order=10 {
    show @ow-table-node
  }

  section @s-spec-sequence "B.6 · Build spec — sequence: a group-edge drop travels the existing pipeline" mode=sequence direction=down gap=compact order=11 {
    show @bq-you @bq-surface @bq-session @bq-capture @bq-planner @bq-journal @bq-door @bq-judge @bq-rulebook @bq-geometry @bq-store @bq-diagnostics
    event @bq-e1 @bq-you -> @bq-surface "drop a node on a group's edge" kind=call activate=true
    event @bq-e2 @bq-surface -> @bq-you "popup: keep-in / move-out / cancel" kind=async activate=false
    event @bq-e3 @bq-you -> @bq-surface "move-out" kind=call activate=true
    event @bq-e4 @bq-surface -> @bq-session "submit(move, meaning): void (proposed)" kind=call
    event @bq-e5 @bq-session -> @bq-capture "captureMove(move, meaning): MoveCapture (proposed)" kind=call
    event @bq-e6 @bq-capture -> @bq-session "MoveCapture" kind=return activate=false
    event @bq-e7 @bq-session -> @bq-planner "planRegroup(capture): EditRequest (proposed)" kind=call
    event @bq-e8 @bq-session -> @bq-journal "submit over HTTP (adapter, existing)" kind=call
    event @bq-e9 @bq-journal -> @bq-door "admit(actor, request): Admitted | Refused (existing route)" kind=call
    event @bq-e10 @bq-door -> @bq-judge "prepare(request, preview=true): Candidate | Rejection (existing)" kind=call
    event @bq-e11 @bq-judge -> @bq-rulebook "validate(request): Verdict — legal | illegal + reasons" kind=call
    event @bq-e12 @bq-judge -> @bq-geometry "the feasibility step (pipeline.ts:32, private) over the adapter: drawable | not drawable + reasons (existing render job)" kind=call
    fragment @bq-outcome alt "The judge's verdict" {
      branch @bq-yes "Every law says yes" {
        event @bq-e13 @bq-journal -> @bq-door "admit(actor, request): Admitted | Refused" kind=call
        event @bq-e14 @bq-door -> @bq-judge "apply(request): Receipt (existing)" kind=call
        event @bq-e15 @bq-judge -> @bq-store "commit(tx): Receipt" kind=call
        event @bq-e16 @bq-store -> @bq-judge "receipt" kind=return activate=false
        event @bq-e17 @bq-judge -> @bq-session "committed — every open canvas re-renders" kind=return activate=false
      }
      branch @bq-no "Any law says no — its rejection already carries the reasons" {
        event @bq-e18 @bq-journal -> @bq-diagnostics "toHumanWords(rejection with reasons): HumanWords (proposed)" kind=call
        event @bq-e19 @bq-journal -> @bq-session "refusal in human words + options (retry · adjust · cancel)" kind=return activate=false
      }
    }
    show @bq-note
  }

  section @s-build-order "B.7 · Build spec — the order I would build it (appendix, restaged)" mode=flow layout=layered direction=right order=12 {
    group @bo-g-foundation "FOUNDATION — prerequisites, nothing new to see" {
      show @bo-1 @bo-2
    }
    group @bo-g-surface "SURFACE — what you will actually feel" {
      show @bo-3 @bo-4 @bo-5
    }
    show @bo-note
    connect @bo-w1 @bo-w2 @bo-w3 @bo-w4
  }
}
