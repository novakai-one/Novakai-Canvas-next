canvas 1
collection @gatekeeper-build-plan "Gatekeeper build — removals, done, tasks" {

  node @rm-table concept "Removed capabilities — what each one does today, and the risk of removing it" role=warning size=large {
    table @rm-t columns=["Removed", "Affects", "What it does today", "Plain words — what changes for you", "Risk to weigh"] {
      row @rm-r1 cells=["G0 · Edit lock (workspace-session.ts)", "Your screen (all diagrams)", "While an earlier edit, undo or review is still being processed, the app refuses any new edit.", "If you click or drag twice quickly, the second edit is currently dropped. After the change, both edits go to the server and are answered in order.", "The server must handle several edits arriving close together and answer them in a sensible order. That is new work, not a free removal."]
      row @rm-r2 cells=["G1 · Movement review — the rearrange-section popup", "Your screen (module diagrams only)", "When you drag a node in a module diagram, the app can interrupt with a popup asking whether you want to rearrange the section instead of moving the node.", "That popup is deleted. This is a screen feature loss, not an agent-authoring change. If you have never seen it, nothing changes for you. If you used it as a shortcut to rearrange sections, that shortcut is gone. This plan specifies no replacement rearrange flow.", "The new keep-in / move-out / cancel popup is not a replacement for it — it appears at a different moment and answers a different question. Confirm you do not rely on the old one."]
      row @rm-r3 cells=["G2 · Drag fails on collapsed content", "Your screen (all diagrams)", "Groups and trees can be collapsed so their children are hidden (this is folding). If you drag something whose contents are collapsed or absent from the canvas, the app stops with the error 'captured group missing'. The server — the program that saves the diagram — is never asked, so nothing is saved.", "A drag that fails with that error today will instead reach the server and either work or get a clear refusal.", "More cases now reach the server. Until the server has answers for them, you may see refusals where you previously saw a failed drag with a technical message — so the refusals must be readable (stage 8)."]
      row @rm-r4 cells=["G3 · Browser roads engine (route-preview.ts)", "Your screen (module diagrams)", "Module diagrams draw wires between modules along planned routes (roads). Today your browser re-computes these routes itself before the server is asked.", "Roads still draw exactly as today, and the visibility toggle still works — only who computes them changes. Your browser stops calculating and asks the server instead (adviseRoutes() calls the judge's previewEdit()). If the server cannot be reached, you see 'judge unreachable'.", "Previews may appear slightly later because they come from the server. This is the change called 'the gatekeeper becomes a messenger': the browser stops checking anything itself."]
      row @rm-r5 cells=["G4 · Journal wedge (submission-session.ts)", "Your screen", "The app records each edit it sends. If one edit fails, every later edit to that diagram is blocked.", "A failed edit no longer blocks the diagram. You can make a failing edit and keep working.", "No user-facing risk. Diagrams that were stuck will accept edits again."]
      row @rm-r6 cells=["The browser as a decider (all five above)", "Your screen", "Five checks inside your browser decide what is allowed before the server is asked. For a human edit, the browser's answer is final today — the server may never see the edit.", "Your browser presents and the server decides. Humans and agents are answered by the same place.", "Every answer now needs a server round-trip, and refusals come from the server. The design accepts this; it is the point of the change."]
    }
    text @rm-note "Each row is something the app does today that it will stop doing after the build. If a row is unclear or unacceptable, raise it before the build starts." role=caption
  }

  node @done-table concept "Definition of done — exact checks, exact pass conditions" role=primary size=large {
    table @done-t columns=["#", "The exact check", "Execute — command / function", "Pass condition (math)"] {
      row @done-r1 cells=["D1", "On every diagram mode, drag node N out of group G: the drop lands, a popup offers keep-in / move-out / cancel, and choosing move-out commits and survives a reload", "Headless browser per mode; popup = drop-choice.askMeaning(); commit = apply.applyEdit()", "(popup options = {keep-in, move-out, cancel}; after reload parent(N) != G; must hold for all modes m in {flow, tree, er, modules, sequence})"]
      row @done-r2 cells=["D2", "Send the same EditRequest at the same base revision R once through the browser and once through the CLI", "Browser submit -> admission.admit() -> apply.previewEdit(); CLI: pnpm canvas preview FILE --revision R (same request); if committing, pnpm canvas apply REQUEST_ID", "(verdict_browser(R) = verdict_CLI(R); if both commit, new_revision_browser = new_revision_CLI)"]
      row @done-r3 cells=["D3", "No browser code refuses an edit before the server is asked — gates G0–G4 removed from the drag path", "grep for throw/refusal on the apps/web drag path; live drag with the server stopped", "(drag-path refusals in apps/web = 0; stopped server -> message = 'judge unreachable' and local verdicts = 0)"]
      row @done-r4 cells=["D4", "A refused edit never blocks the next edit", "Submit refusing edit E1, then valid edit E2 in the same session -> submission-session.releaseOnRejection()", "(outcome(E1) = refused and outcome(E2) = committed; journal(E1).state = released)"]
      row @done-r5 cells=["D5", "Every refusal is plain words plus options; no raw codes on any user-visible surface", "Trigger each refusal type (rule broken, not drawable, revision conflict, judge unreachable) -> outcomes.renderRefusal()", "(raw codes shown = 0; options shown = {retry, adjust, cancel} for every refusal type)"]
      row @done-r6 cells=["D6", "Module diagrams have no modules-only popups and no browser roads engine; one law set serves all modes", "grep for modules-only branches on the drag path; run D1 on a modules diagram", "(modules-only drag-path branches = 0; D1(modules) = pass)"]
      row @done-r7 cells=["D7", "pnpm check shows no new failures versus main", "Run pnpm check on the branch; diff the failures against the recorded main baseline", "(new failures on branch = 0)"]
      row @done-r8 cells=["D8", "The known broken module-node drag on main (PR #106's target) is fixed or explicitly deferred in writing", "Headless drag of a module node, or append the written decision to this collection", "(node position after commit = drop position) or (written deferral exists in this collection)"]
    }
    text @done-note "These are gates, unlike the line estimates. If a row cannot be proven, the build is not done." role=caption
  }

  node @task-table concept "Task list — the stage tracker (read top to bottom = build order)" role=primary size=large {
    table @task-t columns=["Stage", "Task", "What the builder is doing", "Task done when…", "Est. lines (+/-)", "What you will observe", "Achieves"] {
      row @task-r1 cells=["1 of 9", "Un-wedge the journal", "submission-session.ts: when the judge returns a typed rejection, releaseOnRejection() marks the journal entry released instead of leaving it in-flight", "Refuse once, then commit in the same session", "+20 / -25", "Nothing in normal use. A failing edit no longer blocks the next edit.", "D4"]
      row @task-r2 cells=["2 of 9", "De-gate and split workspace-session", "Remove the edit lock (G0) and movement review (G1) from workspace-session.ts so submits go straight to the server; then split the 2,905-line file into session / advice / coordination", "No local verdict on the drag path; the split lands or its deferral is written down", "+40 / -380", "Rapid successive edits stop being silently dropped. The file split itself is invisible.", "D3"]
      row @task-r3 cells=["3 of 9", "Capture and plan both meanings", "movement-capture.ts stops throwing 'captured group missing'. plan.ts + regroup.ts turn one group-edge drop into two candidate EditRequests — one keep-in, one move-out (planRegroup())", "A group-edge drop yields both plans; nothing throws", "+175 / -75", "Drags that used to stop with 'captured group missing' now work or get a clear refusal.", "D1, D3"]
      row @task-r4 cells=["4 of 9", "Demote route-preview to adviser", "route-preview.ts deletes its in-browser roads calculation; adviseRoutes() calls the judge's previewEdit() and displays what the server returns", "No roads engine in the browser", "+30 / -70", "Wire previews on module diagrams may appear slightly later; they match what the server will commit.", "D3, D6"]
      row @task-r5 cells=["5 of 9", "Judge pipeline: preview + apply", "apply.ts gains previewEdit(): it runs the same law checks as applyEdit() but commits nothing, so the browser can ask 'what would happen'. admission.ts lets human requests use it. applyEdit() becomes the one commit path for CLI and browser.", "The same EditRequest gets the same verdict from browser and CLI", "+85 / -5", "Nothing directly. The app and the CLI give the same answer to the same edit.", "D2"]
      row @task-r6 cells=["6 of 9", "The group-edge popup", "drop-choice.ts (new): askMeaning() shows keep-in / move-out / cancel at the drop spot; CanvasSurface.tsx hosts it and submits the chosen meaning", "The popup works on every diagram mode", "+205 / -10", "Drop a node on a group's edge and a popup asks: keep in group, move out, or cancel.", "D1"]
      row @task-r7 cells=["7 of 9", "Regroup patches and group growth", "structural.ts: buildRegroupPatch() emits the ungroup patch for move-out. nested-support-expansion.ts: growGroup() grows the group bounds for keep-in", "Both choices commit and survive reload", "+105 / 0", "'keep in' grows the group around the node; 'move out' removes it from the group. Both persist after reload.", "D1"]
      row @task-r8 cells=["8 of 9", "Refusals in human words", "outcomes.ts: renderRefusal() turns a law's rejection (rule broken, collision, revision conflict) into plain words plus retry / adjust / cancel", "Every refusal surface passes D5", "+70 / -10", "A refused edit tells you why in plain words and offers retry, adjust, or cancel.", "D5"]
      row @task-r9 cells=["9 of 9", "Modules loses its special cases", "Delete the modules-only branches from the drag path (the rearrange popup, the separate in-browser routing); module diagrams use the same code as every other mode", "Module diagrams pass the same checks as other modes", "included above", "Module diagrams behave like every other diagram. No module-only popups.", "D6"]
    }
    text @task-note "During the build, 'stage 4 of 9' refers to this table. Line estimates sum exactly to B.4's totals (+730 / -575); stage 9 is the removal half of stages 2–4, not new work. The Achieves column maps stages to done conditions; D7 and D8 are whole-build checks made after stage 9, so no single stage owns them." role=caption
  }

  section @s-removed "1 · Removed capabilities — what changes, and the risk of each" mode=flow direction=right order=0 {
    show @rm-table
  }

  section @s-done "2 · Definition of done — exact checks, exact pass conditions" mode=flow direction=right order=1 {
    show @done-table
  }

  section @s-tasks "3 · Task list — nine stages, tracked here" mode=flow direction=right order=2 {
    show @task-table
  }
}
